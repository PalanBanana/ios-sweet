+++ b/iokit/Kernel/arm/SweetWifi.cpp
@@ -0,0 +1,191 @@
+/*
+ * SWEET: WCN3990 controller, SNOC + QMI model (see SweetWifi.h).
+ *
+ * Sources for each step are cited inline. Voltages are not in the fetched
+ * files and stay 미확정 (device tree). The earlier GENI FIFO model was
+ * refuted (NOTES.md, P0) and is not carried here.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include "SweetWifi.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(Wcn3990Controller, IOService)
+
+/*
+ * Boot-arg gate: only the exact value 1 opens it. The buffer is int64_t and
+ * max_len is 8, because argnumcpy stores (int32_t)val at max_len 4, so
+ * sweetwifi=4294967297 would read back as 1 (bootargs.c:362). A bare name, or any value that is not
+ * the number 1, keeps the gate closed.
+ */
+static bool
+sweetWifiGateOpen(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetwifi", &value, (int)sizeof(value)) && value == 1;
+}
+
+/* snoc.c:48-54 ath10k_regulators. Voltages 미확정 (device tree). */
+static const char * const kRegulators[] = {
+	"vdd-0.8-cx-mx",  /* first rail: powers part of the SoC (snoc.c:1814-1818) */
+	"vdd-1.8-xo",
+	"vdd-1.3-rfa",
+	"vdd-3.3-ch0",
+	"vdd-3.3-ch1",
+};
+
+/* snoc.c:56-58 ath10k_clocks */
+static const char * const kClocks[] = {
+	"cxo_ref_clk_pin",
+	"qdss",
+};
+
+bool Wcn3990Controller::init(OSDictionary *dict)
+{
+	if (!super::init(dict)) {
+		return false;
+	}
+	fSnocMem = NULL;
+	fPwrseqPresent = false;
+	fReady = false;
+	return true;
+}
+
+bool Wcn3990Controller::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	if (snocMap(provider) != kIOReturnSuccess) {
+		printf("SWEET WIFI: SNOC membase map failed\n");
+		return false;
+	}
+	printf("SWEET WIFI: SNOC membase mapped (no register access)\n");
+
+	/* VALUE checked: only sweetwifi=1 enables power and QMI */
+	if (!sweetWifiGateOpen()) {
+		printf("SWEET WIFI: sweetwifi=1 not set; power and QMI untouched\n");
+		registerService();
+		return true;
+	}
+
+	/*
+	 * Gate. Power comes first in ath10k (snoc.c:1101-1107) but the QMI
+	 * transport must exist before anything is powered. QRTR is not in XNU,
+	 * so with it missing no rail is enabled.
+	 */
+	if (!qmiTransportAvailable()) {
+		printf("SWEET WIFI: sweetwifi=1 refused: no QMI/QRTR transport in this kernel; no rail enabled\n");
+		return false;
+	}
+	if (powerOn() != kIOReturnSuccess ||
+	    qmiServerArrive() != kIOReturnSuccess ||
+	    qmiMsaReady() != kIOReturnSuccess ||
+	    qmiWlanEnable(false) != kIOReturnSuccess) {
+		printf("SWEET WIFI: bring-up failed\n");
+		powerOff();
+		return false;
+	}
+	fReady = true;
+	printf("SWEET WIFI: ready\n");
+	registerService();
+	return true;
+}
+
+IOReturn Wcn3990Controller::snocMap(IOService *provider)
+{
+	/* snoc.c:1322 looks up "membase" by name. IOKit has only the index, which
+	 * is 미확정 until the device tree node is mapped. */
+	fSnocMem = provider->mapDeviceMemoryWithIndex(0);
+	return fSnocMem ? kIOReturnSuccess : kIOReturnNoResources;
+}
+
+IOReturn Wcn3990Controller::powerOn(void)
+{
+	/*
+	 * snoc.c:1022-1048 ath10k_hw_power_on order:
+	 *   1. pwrseq_enable("wlan")           external sequence owns the PMU rails
+	 *   2. regulator_bulk_enable           snoc.c:1033
+	 *   3. clk_bulk_prepare_enable         snoc.c:1037
+	 * Regulator count (snoc.c:1804-1820): with pwrseq present only the first
+	 * rail is ours; without pwrseq all five are enabled.
+	 */
+	if (!fPwrseqPresent) {
+		printf("SWEET WIFI: pwrseq absent: all %zu rails are driver-owned\n",
+		    sizeof(kRegulators) / sizeof(kRegulators[0]));
+	}
+	(void)kClocks;
+	(void)kRegulators;
+	return kIOReturnUnsupported;
+}
+
+IOReturn Wcn3990Controller::powerOff(void)
+{
+	/* Reverse of powerOn (snoc.c:1051-1066). Unreachable until powerOn runs. */
+	return kIOReturnSuccess;
+}
+
+bool Wcn3990Controller::qmiTransportAvailable(void)
+{
+	/* qmi.c:1098 qmi_handle_init() runs on the QRTR socket. QRTR does not
+	 * exist in XNU, so this is always false until a transport is provided. */
+	return false;
+}
+
+IOReturn Wcn3990Controller::qmiServerArrive(void)
+{
+	/* qmi.c:808 order: IND_REGISTER, HOST_CAP (optional), MSA_INFO,
+	 * setup MSA permissions, MSA_READY, CAP. */
+	return kIOReturnUnsupported;
+}
+
+IOReturn Wcn3990Controller::qmiMsaReady(void)
+{
+	/* qmi.c:918 order: fetch board file, BDF_DOWNLOAD, CAL_REPORT. */
+	return kIOReturnUnsupported;
+}
+
+IOReturn Wcn3990Controller::qmiWlanEnable(bool ftm)
+{
+	/* qmi.c:515 order: WLAN_CFG_REQ, then WLAN_MODE_REQ (QMI_WLFW_MISSION_V01
+	 * or QMI_WLFW_FTM_V01, snoc.c:1007-1011). */
+	(void)ftm;
+	return kIOReturnUnsupported;
+}
+
+IOReturn Wcn3990Controller::enable(void)
+{
+	return fReady ? kIOReturnSuccess : kIOReturnNotReady;
+}
+
+IOReturn Wcn3990Controller::disable(void)
+{
+	fReady = false;
+	return kIOReturnSuccess;
+}
+
+IOReturn Wcn3990Controller::getHardwareAddress(uint8_t mac[6])
+{
+	/* 미확정: the MAC comes from firmware over QMI, which is not reachable. */
+	(void)mac;
+	return kIOReturnNotReady;
+}
+
+void Wcn3990Controller::stop(IOService *provider)
+{
+	disable();
+	super::stop(provider);
+}
+
+void Wcn3990Controller::free(void)
+{
+	OSSafeReleaseNULL(fSnocMem);
+	super::free();
+}
+
+#endif /* SWEET */
