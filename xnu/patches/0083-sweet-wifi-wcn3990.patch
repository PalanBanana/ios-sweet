+/*
+ * SWEET: WCN3990 Wi-Fi/BT bring-up over GENI SE firmware streaming.
+ *
+ * Status: skeleton. start() maps the GENI SE block and logs its state.
+ * Rail votes and firmware streaming run only with boot-arg sweetwifi=1.
+ * IO80211Family is a separate kext and is not in the xnu tree, so this
+ * class derives from IOService and exposes a narrow interface for the
+ * 802.11 bridge to be added later.
+ */
+#ifndef _SWEET_WIFI_WCN3990_H_
+#define _SWEET_WIFI_WCN3990_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class Wcn3990Controller : public IOService {
+	OSDeclareDefaultStructors(Wcn3990Controller);
+
+private:
+	IOMemoryMap                 *fGeni;      /* GENI SE register block */
+	volatile uint32_t           *fRegs;
+	IOBufferMemoryDescriptor    *fFwBuf;     /* firmware staging buffer */
+	bool                        fReady;
+
+	uint32_t readReg(uint32_t off);
+	void     writeReg(uint32_t off, uint32_t val);
+
+	IOReturn voteRpmhRegulator(const char *name, uint32_t uv, bool on);
+	IOReturn geniSeInit(void);
+	IOReturn geniFifoWrite(uint32_t word);
+	IOReturn streamFirmware(void);
+
+public:
+	virtual bool init(OSDictionary *dict = NULL) override;
+	virtual bool start(IOService *provider) override;
+	virtual void stop(IOService *provider) override;
+	virtual void free(void) override;
+
+	IOReturn enable(void);
+	IOReturn disable(void);
+};
+
+#endif /* _SWEET_WIFI_WCN3990_H_ */
