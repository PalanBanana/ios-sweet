+++ b/iokit/Kernel/arm/SweetWifi.h
@@ -0,0 +1,55 @@
+/*
+ * SWEET: WCN3990 Wi-Fi controller, SNOC + QMI model (ath10k snoc.c / qmi.c).
+ *
+ * Layers (mirrors ath10k):
+ *   Power     pwrseq (external) or regulators, then clocks   snoc.c:1022-1048,
+ *                                                            snoc.c:1804-1820
+ *   Control   QMI wlfw requests over QRTR                    qmi.c:515, 808, 918
+ *   Transport SNOC: membase MMIO and copy engines            snoc.c:1322-1333
+ *
+ * Status: skeleton, dormant. start() maps the SNOC block and performs no
+ * register access. sweetwifi=1 checks the QMI transport first, and the
+ * kernel has none (QRTR is not in XNU), so no rail is enabled and the
+ * driver refuses to start. The IO80211 bridge is kept as plain methods:
+ * IO80211Family is a separate kext and is not in the xnu tree.
+ */
+#ifndef _SWEET_WIFI_WCN3990_H_
+#define _SWEET_WIFI_WCN3990_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class Wcn3990Controller : public IOService {
+	OSDeclareDefaultStructors(Wcn3990Controller);
+
+private:
+	IOMemoryMap     *fSnocMem;   /* SNOC membase (snoc.c:1322, "membase") */
+	bool            fPwrseqPresent;
+	bool            fReady;
+
+	/* Transport (SNOC) */
+	IOReturn snocMap(IOService *provider);
+
+	/* Power: pwrseq, then regulators, then clocks (snoc.c:1022-1048) */
+	IOReturn powerOn(void);
+	IOReturn powerOff(void);
+
+	/* Control: QMI wlfw handshake (qmi.c) */
+	bool     qmiTransportAvailable(void);
+	IOReturn qmiServerArrive(void);   /* qmi.c:808 */
+	IOReturn qmiMsaReady(void);       /* qmi.c:918 */
+	IOReturn qmiWlanEnable(bool ftm); /* qmi.c:515 */
+
+public:
+	virtual bool init(OSDictionary *dict = NULL) override;
+	virtual bool start(IOService *provider) override;
+	virtual void stop(IOService *provider) override;
+	virtual void free(void) override;
+
+	/* IO80211 bridge, as plain methods */
+	IOReturn enable(void);
+	IOReturn disable(void);
+	IOReturn getHardwareAddress(uint8_t mac[6]);
+};
+
+#endif /* _SWEET_WIFI_WCN3990_H_ */
