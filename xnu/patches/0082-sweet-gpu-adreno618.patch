+/*
+ * SWEET: GPU SMMU (kgsl_smmu, sweet.dts:10589), an SMMU v2 for the Adreno 618. Session 22 stage
+ * (NOTES.md session 22, Task D):
+ *   allocateTables()  the physically contiguous pool for the page tables. No register access.
+ *   mapIova()         writes page-table entries in that pool. No register access.
+ *   program()         sweetmmu=1 only. Maps the block and reads sIDR0 and sIDR1 (reads only), then
+ *                     returns kIOReturnUnsupported. Stream mapping and context-bank writes are not
+ *                     implemented: the context-bank layout (sIDR1 page size and count) is not verified.
+ * The page tables are LPAE, 32-bit IOVA, 3 levels, 4 KiB granule (SweetSmmuPgtbl.h).
+ */
+#ifndef _SWEET_SMMU_V2_H_
+#define _SWEET_SMMU_V2_H_
+
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include "SweetSmmuPgtbl.h"
+
+class SweetSmmuV2 {
+public:
+	SweetSmmuV2(void);
+	IOReturn allocateTables(void);
+	IOReturn mapIova(uint64_t iova, IOPhysicalAddress pa, size_t len);
+	IOReturn program(void);
+	void     teardown(void);
+
+private:
+	IOBufferMemoryDescriptor    *fPool;         /* page-table pool, physically contiguous */
+	IOMemoryMap                 *fMmio;         /* kgsl_smmu block, mapped by physical address, only by program() */
+	SweetPgtPool                fTables;
+	bool                        fTablesReady;
+};
+
+#endif /* _SWEET_SMMU_V2_H_ */
