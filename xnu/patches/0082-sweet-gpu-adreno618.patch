+/*
+ * SWEET: Adreno 618 (SM7150, a6xx) bring-up driver for XNU IOKit.
+ *
+ * Values come from sweet.dts (GPU node, lines 17748-18197; cited in SweetGPU.cpp)
+ * and from Mesa a6xx.xml and Linux a6xx_gpu.c. start() maps the GPU window
+ * only. With boot-arg sweetgpu=1 it also maps cx_dbgc, cx_misc and qfprom,
+ * maps gpucc by physical address to read the GX GDSC (reads only), maps the
+ * GMU register block by physical address (no access), reads the speed bin
+ * from qfprom, and writes RBBM and CP registers (reset, interrupt
+ * mask, SECVID, ring base, CP_PROTECT). No zap is loaded. The
+ * DT zap node is not a child of the GPU node, so Linux takes its -ENODEV path
+ * for this DT, and this driver does the same.
+ *
+ * 미확정: clocks, GX power-up (the GDSC is only read), GBIF/LLCC, SMMU, CP
+ * start, 64-bit address mode, frame submission. HWCG is not written: Linux
+ * does not apply a615_hwcg on this DT (adreno_device.c:56). No IOKit
+ * personality matches this class, so start() runs only if the class is
+ * instantiated explicitly.
+ */
+#ifndef _SWEET_GPU_ADRENO618_H_
+#define _SWEET_GPU_ADRENO618_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+/* One pwrlevel bin of sweet.dts gpu-pwrlevel-bins (table in SweetGPU.cpp). */
+struct SweetGpuPwrBin {
+	uint32_t speedBin;      /* qcom,speed-bin */
+	uint32_t initLevel;     /* qcom,initial-pwrlevel */
+	uint32_t caLevel;       /* qcom,ca-target-pwrlevel */
+	uint32_t nLevels;       /* entries in freqHz, DT order, fastest first */
+	uint32_t freqHz[9];     /* Hz; 0 is the off level */
+};
+
+class MsmGpuAdreno618 : public IOService {
+	OSDeclareDefaultStructors(MsmGpuAdreno618);
+
+private:
+	IOMemoryMap                 *fMmio;         /* reg window 0: GPU block */
+	IOMemoryMap                 *fCxDbgc;       /* reg window 1: cx_dbgc */
+	IOMemoryMap                 *fCxMisc;       /* reg window 2: cx_misc */
+	IOMemoryMap                 *fQfprom;       /* reg window 3: qfprom (fuses) */
+	IOMemoryMap                 *fGpucc;        /* gpucc, mapped by physical address (GX GDSC), not an ADT window */
+	IOMemoryMap                 *fGmu;          /* GMU register block (sweet.dts:18230), mapping only, not accessed yet */
+	volatile uint32_t           *fRegs;         /* GPU block, dword indices */
+	volatile uint32_t           *fQfpromRegs;   /* qfprom, dword indices (readFuse passes byteOff / 4) */
+	volatile uint32_t           *fGpuccRegs;    /* gpucc, byte offsets from kGpuccPA (readGpucc passes byteOff / 4) */
+	IOBufferMemoryDescriptor    *fRingBuf;      /* 32 KiB ring, physically contiguous */
+	const SweetGpuPwrBin        *fPwrBin;       /* table selected by speed bin */
+	uint32_t                    fSpeedBin;
+	uint32_t                    fRingWptr;
+	uint32_t                    fFence;
+	uint32_t                    fIrqCount;
+	uint32_t                    fLastIntStatus;
+	bool                        fReady;
+	bool                        fIrqRegistered;
+
+	uint32_t readReg(uint32_t idx);
+	void     writeReg(uint32_t idx, uint32_t val);
+	uint32_t readFuse(uint32_t byteOff);
+	uint32_t readGpucc(uint32_t byteOff);
+	bool     mapWindow(IOService *provider, uint32_t index, uint64_t minBytes,
+	    IOMemoryMap **map, const char *name);
+	bool     mapPhysical(uint64_t pa, uint64_t minBytes, IOMemoryMap **map,
+	    const char *name);
+	void     teardown(void);
+
+	IOReturn checkGxPowered(void);
+	IOReturn powerUpSequence(void);
+	IOReturn initRingbuffer(void);
+	IOReturn loadZapFirmware(void);
+	bool     waitIdle(uint32_t timeoutUs);
+	static void handleInterrupt(OSObject *target, void *refCon, IOService *nub, int source);
+
+public:
+	virtual bool     init(OSDictionary *dict = NULL) override;
+	virtual IOService *probe(IOService *provider, SInt32 *score) override;
+	virtual bool     start(IOService *provider) override;
+	virtual void     stop(IOService *provider) override;
+	virtual void     free(void) override;
+
+	/*
+	 * Frame submission. 미확정: returns kIOReturnUnsupported until a command
+	 * stream (CP_INDIRECT_BUFFER) and fence design exists. CP_MEM_TO_MEM
+	 * copies dwords and cannot move a surface (adreno_pm4.xml:1368).
+	 */
+	IOReturn submitFrame(uint64_t surfacePA, uint32_t bytes, uint32_t *fenceOut);
+};
+
+#endif /* _SWEET_GPU_ADRENO618_H_ */
