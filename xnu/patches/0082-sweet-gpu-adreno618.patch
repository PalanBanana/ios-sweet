+
+bool MsmGpuAdreno618::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	/* Window 0 is mapped with or without the gate. Mapping is not a register access. */
+	if (!mapWindow(provider, 0, kGpuRegBytes, &fMmio, "gpu")) {
+		return false;
+	}
+	fRegs = (volatile uint32_t *)fMmio->getVirtualAddress();
+
+	if (!sweetGpuGateOpen()) {
+		printf("SWEET GPU: sweetgpu=1 not set; leaving hardware untouched\n");
+		registerService();
+		return true;
+	}
+
+	/* The gate is open from here on. Windows 1-3 are mapped only now. */
+	if (!mapWindow(provider, 1, kCxDbgcBytes, &fCxDbgc, "cx_dbgc") ||
+	    !mapWindow(provider, 2, kCxMiscBytes, &fCxMisc, "cx_misc") ||
+	    !mapWindow(provider, 3, kQfpromBytes, &fQfprom, "qfprom")) {
+		teardown();
+		return false;
+	}
+	fQfpromRegs = (volatile uint32_t *)fQfprom->getVirtualAddress();
+
+	/*
+	 * gpucc is not an ADT window of this node, so it is mapped by address and the ADT
+	 * stays unchanged. Mapping alone is not a register access.
+	 */
+	if (!mapPhysical(kGpuccPA, kGpuccBytes, &fGpucc, "gpucc (GX GDSC)")) {
+		teardown();
+		return false;
+	}
+	fGpuccRegs = (volatile uint32_t *)fGpucc->getVirtualAddress();
+
+	/*
+	 * GMU register block (sweet.dts:18230, kgsl_gmu_reg). Mapping only: nothing in this
+	 * driver reads or writes the GMU yet, so no GMU state changes here.
+	 */
+	if (!mapPhysical(kGmuPA, kGmuBytes, &fGmu, "gmu (mapping only)")) {
+		teardown();
+		return false;
+	}
+
+	/* Speed bin: a read of qfprom fuses, not of the GPU block. */
+	fSpeedBin = (readFuse(kSpeedBinOff) & kSpeedBinMask) >> kSpeedBinShift;
+	fPwrBin = selectPwrBin(fSpeedBin);
+	if (!fPwrBin || fPwrBin->initLevel >= fPwrBin->nLevels ||
+	    fPwrBin->freqHz[fPwrBin->initLevel] == kPwrSentinel) {
+		printf("SWEET GPU: speed-bin %#x has no usable pwrlevel bin; not started\n", fSpeedBin);
+		teardown();
+		return false;
+	}
+	printf("SWEET GPU: speed-bin %#x -> init level %u = %u Hz, ca level %u "
+	    "(clock not programmed; DT chip-id %#x unverified)\n",
+	    fSpeedBin, fPwrBin->initLevel, fPwrBin->freqHz[fPwrBin->initLevel],
+	    fPwrBin->caLevel, kChipIdDt);
+
+	/*
+	 * Linux takes its no-zap path (a6xx_gpu.c:1515-1516) when zap init returns
+	 * -ENODEV. kIOReturnUnsupported is that result here. Any other result would
+	 * need CP_SET_SECURE_MODE, which this driver does not write, so it refuses.
+	 */
+	IOReturn zap = loadZapFirmware();
+	if (zap != kIOReturnUnsupported) {
+		printf("SWEET GPU: zap result %#x not handled; not started\n", (unsigned)zap);
+		teardown();
+		return false;
+	}
+	printf("SWEET GPU: no zap loaded; continuing on the SECVID path as Linux does for "
+	    "-ENODEV. A GPU that needs secure mode may fault here.\n");
+
+	if (powerUpSequence() != kIOReturnSuccess) {
+		printf("SWEET GPU: power-up failed\n");
+		teardown();
+		return false;
+	}
+	if (initRingbuffer() != kIOReturnSuccess) {
+		printf("SWEET GPU: ring buffer init failed\n");
+		teardown();
+		return false;
+	}
+	if (registerInterrupt(kGpuIrqSource, this, handleInterrupt) != kIOReturnSuccess) {
+		printf("SWEET GPU: interrupt registration failed\n");
+		teardown();
+		return false;
+	}
+	fIrqRegistered = true;
+	fReady = true;
+	printf("SWEET GPU: ready\n");
+	registerService();
+	return true;
+}
+
+void MsmGpuAdreno618::teardown(void)
+{
+	if (fReady) {
+		/* Mask before the windows go, so no RBBM_INT_0 source fires on released memory. */
+		writeReg(kRbbmInt0Mask, 0);
+		fReady = false;
+	}
+	if (fIrqRegistered) {
+		(void)unregisterInterrupt(kGpuIrqSource);
+		fIrqRegistered = false;
+	}
+	OSSafeReleaseNULL(fRingBuf);
+	OSSafeReleaseNULL(fGmu);
+	OSSafeReleaseNULL(fGpucc);
+	OSSafeReleaseNULL(fQfprom);
+	OSSafeReleaseNULL(fCxMisc);
+	OSSafeReleaseNULL(fCxDbgc);
+	OSSafeReleaseNULL(fMmio);
+	fRegs = NULL;
+	fQfpromRegs = NULL;
+	fGpuccRegs = NULL;
+	fPwrBin = NULL;
+}
+
+void MsmGpuAdreno618::handleInterrupt(OSObject *target, void *refCon, IOService *nub, int source)
+{
+	(void)refCon;
+	(void)nub;
+	(void)source;
+	/* Registered only in start(), and removed in teardown() before the windows go. */
+	MsmGpuAdreno618 *self = static_cast<MsmGpuAdreno618 *>(target);
+	self->fLastIntStatus = self->readReg(kRbbmInt0Status);
+	self->fIrqCount++;
+}
+
+bool MsmGpuAdreno618::waitIdle(uint32_t timeoutUs)
+{
+	/* Poll with a fixed delay instead of a timebase: the tick rate is not
+	 * verified for this board. */
+	for (uint32_t waited = 0; waited < timeoutUs; waited += 10) {
+		/* a6xx_gpu.c:128: idle when RBBM_STATUS & ~CP_AHB_BUSY_CX_MASTER == 0 */
+		if (!(readReg(kRbbmStatus) & ~kRbbmStatusCxAhbBusy)) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}
+
+IOReturn MsmGpuAdreno618::checkGxPowered(void)
+{
+	/*
+	 * Reads only. The judgement is GDSC_POWER_UP_COMPLETE in CFG_GDSCR. PWR_ON in
+	 * GDSCR must agree. A disagreement (a transition in progress, or a wrong window)
+	 * is refused as well.
+	 */
+	if (!fGpuccRegs) {
+		return kIOReturnNotReady;
+	}
+	uint32_t cfg = readGpucc(kGdscCfgOff);
+	uint32_t pwr = readGpucc(kGdscOff);
+	bool ready = (cfg & kGdscPowerUpComplete) != 0;
+	bool on = (pwr & kGdscPwrOn) != 0;
+	printf("SWEET GPU: GX GDSC CFG_GDSCR=%#x (power-up complete %d), GDSCR=%#x (PWR_ON %d)\n",
+	    cfg, (int)ready, pwr, (int)on);
+	if (ready != on) {
+		printf("SWEET GPU: GX GDSC readings disagree; no writes\n");
+		return kIOReturnError;
+	}
+	if (!ready) {
+		printf("SWEET GPU: GX rail off; no writes\n");
+		return kIOReturnOffline;
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::powerUpSequence(void)
+{
+	/*
+	 * The first GX access of this driver. Nothing below runs unless the GX GDSC
+	 * reads as powered. checkGxPowered writes nothing.
+	 */
+	IOReturn gx = checkGxPowered();
+	if (gx != kIOReturnSuccess) {
+		return gx;
+	}
+
+	/*
+	 * RBBM_SW_RESET_CMD assert, then deassert, with readback (a6xx_gpu.c:2128-2130).
+	 * 미확정: Linux runs this only in a6xx_recover, for gmu-wrapper and rgmu parts
+	 * (a6xx_gpu.c:1606-1612), not in hw_init. Kept from the first version.
+	 */
+	writeReg(kRbbmSwResetCmd, 1);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+	writeReg(kRbbmSwResetCmd, 0);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+
+	/*
+	 * TSB (trusted range off) and ADDR_MODE (64-bit addressing), in the order of
+	 * a6xx hw_init (a6xx_gpu.c:1210-1236). The ADDR_MODE writes sit under
+	 * !adreno_is_a7xx (a6xx_gpu.c:1223), which a618 satisfies.
+	 */
+	writeReg(kRbbmSecvidTsbCntl, 0);
+	writeReg(kRbbmSecvidTsbTrustedBase, 0);        /* reg64 lo */
+	writeReg(kRbbmSecvidTsbTrustedBase + 1, 0);    /* reg64 hi */
+	writeReg(kRbbmSecvidTsbTrustedSize, 0);
+	writeReg(kCpAddrModeCntl, kAddrMode64);
+	writeReg(kVscAddrModeCntl, kAddrMode64);
+	writeReg(kGrasAddrModeCntl, kAddrMode64);
+	writeReg(kRbAddrModeCntl, kAddrMode64);
+	writeReg(kPcAddrModeCntl, kAddrMode64);
+	writeReg(kHlsqAddrModeCntl, kAddrMode64);
+	writeReg(kVfdAddrModeCntl, kAddrMode64);
+	writeReg(kVpcAddrModeCntl, kAddrMode64);
+	writeReg(kUcheAddrModeCntl, kAddrMode64);
+	writeReg(kSpAddrModeCntl, kAddrMode64);
+	writeReg(kTpl1AddrModeCntl, kAddrMode64);
+	writeReg(kRbbmSecvidTsbAddrModeCntl, kAddrMode64);
+
+	/*
+	 * CP_PROTECT (a6xx_gpu.c:723-746). Linux writes it after the hw_init ADDR_MODE
+	 * block and before RBBM_INT_0_MASK (a6xx_gpu.c:1384, 1436). CNTL first, then the
+	 * 32 entries in order, entry 31 last: the infinite span (a6xx_gpu.c:744-745).
+	 */
+	writeReg(kCpProtectCntl, kCpProtectCntlVal);
+	for (uint32_t i = 0; i < kCpProtectCount; i++) {
+		writeReg(kCpProtectBase + i, kCpProtectRegs[i]);
+	}
+
+	/*
+	 * 0 masks every RBBM_INT_0 source (a6xx_gpu.c:1849, the hang path). Linux
+	 * hw_init writes A6XX_INT_MASK here instead (a6xx_gpu.c:1436). 미확정: the
+	 * nonzero mask waits until the IRQ path is checked on hardware.
+	 */
+	writeReg(kRbbmInt0Mask, 0);
+
+	/*
+	 * SECVID set once, here only (sweet.dts:17759 qcom,gpu-quirk-secvid-set-once).
+	 * 0 is the value Linux writes on the no-zap path (a6xx_gpu.c:1515-1516).
+	 * Linux warns that a wrong guess blocks this register (a6xx_gpu.c:1496-1497).
+	 * stop() never writes it again.
+	 */
+	writeReg(kRbbmSecvidTrustCntl, 0);
+
+	/* GBIF_SCACHE_CNTL0/1 are not written: the kernel derives them from an LLCC
+	 * slice id (a6xx_gpu.c:1979-2051), which this board has not provided. 미확정. */
+	if (!waitIdle(100000)) {
+		printf("SWEET GPU: RBBM not idle after reset\n");
+		return kIOReturnTimeout;
+	}
+	printf("SWEET GPU: power-up done, RBBM_STATUS=%#x\n", readReg(kRbbmStatus));
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::loadZapFirmware(void)
+{
+	/*
+	 * Not implemented: a615_zap needs SCM (PAS init, auth, reset), and this
+	 * driver has no SCM path. The DT node pil_gpu (qcom,kgsl-hyp, pas-id 0x0d,
+	 * firmware a615_zap, sweet.dts:17674-17678) has no reference from the GPU
+	 * node. Linux finds the zap only as a child named "zap-shader"
+	 * (adreno_gpu.c:49), so Linux returns -ENODEV for this DT. start() takes the
+	 * same path on kIOReturnUnsupported.
+	 */
+	return kIOReturnUnsupported;
+}
+
+IOReturn MsmGpuAdreno618::initRingbuffer(void)
+{
+	/* Physically contiguous: the GPU reads the ring by address, and no SMMU mapping exists here. */
+	fRingBuf = IOBufferMemoryDescriptor::withOptions(
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, kRingBytes, page_size);
+	if (!fRingBuf) {
+		return kIOReturnNoMemory;
+	}
+	uint64_t ringPA = (uint64_t)fRingBuf->getPhysicalAddress();
+	/* gpu_write64(CP_RB_BASE), a6xx_gpu.c:1446: lo at the index, hi at index+1 */
+	writeReg(kCpRbBase, (uint32_t)ringPA);
+	writeReg(kCpRbBase + 1, (uint32_t)(ringPA >> 32));
+	/*
+	 * CP_RB_CNTL = MSM_GPU_RB_CNTL_DEFAULT | NO_UPDATE (a6xx_gpu.c:1452-1456). hw_apriv is 0
+	 * on this chip: neither 0x06010800 catalog entry has ADRENO_QUIRK_HAS_HW_APRIV, and
+	 * hw_apriv comes from that quirk (a6xx_gpu.c:2717-2718). No RPTR shadow is configured:
+	 * CP_RB_RPTR_ADDR is not written (a6xx_gpu.c:1459-1464), so the hardware must not update one.
+	 */
+	writeReg(kCpRbCntl, kRbCntlDefault | kRbCntlNoUpdate);
+	fRingWptr = 0;
+	writeReg(kCpRbWptr, 0);
+	printf("SWEET GPU: ring pa=%#llx bytes=%u (CP_RB_CNTL NO_UPDATE set)\n",
+	    (unsigned long long)ringPA, kRingBytes);
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::submitFrame(uint64_t surfacePA, uint32_t bytes,
+    uint32_t *fenceOut)
+{
+	/*
+	 * 미확정: a frame is not a CP_MEM_TO_MEM. That packet copies dwords
+	 * (adreno_pm4.xml:1368, DST + SRC_A addresses), so it cannot move a surface.
+	 * Real submission needs a command stream (CP_INDIRECT_BUFFER) and a fence.
+	 * Nothing here writes a register or the ring, so this stays unsupported.
+	 */
+	(void)surfacePA;
+	(void)bytes;
+	(void)fenceOut;
+	return kIOReturnUnsupported;
+}
+
+void MsmGpuAdreno618::stop(IOService *provider)
+{
+	/* Writes only happen if start() reached the ready state. */
+	teardown();
+	super::stop(provider);
+}
+
+void MsmGpuAdreno618::free(void)
+{
+	teardown();
+	super::free();
+}
+
+/*
+ * SMMU v2 for the GPU (session 22, Task D). Class in SweetSmmuV2.h, page tables in
+ * SweetSmmuPgtbl.h. Only the page-table pool and mapIova() touch memory. program() reads SMMU
+ * registers, and only behind sweetmmu=1. It writes nothing.
+ */
+
+/*
+ * DT facts. sweet.dts:10592 reg = <0x5040000 0x10000>. The iommus specifiers <0x1cd N> (N is the
+ * stream ID) are GPU at 18215 and 18222 and GMU at 18263 and 18269. The clocks (clock-names
+ * gcc_gpu_memnoc_gfx_clk, sweet.dts:10601-10602) and the vdd supply (10598-10599) must be on
+ * before any register access. This driver does not enable them, which is one reason program()
+ * refuses to write.
+ */
+static const uint64_t kSmmuPA = 0x5040000;
+static const uint64_t kSmmuBytes = 0x10000;
+static const uint32_t kSidGpu[] = { 0x00, 0x02 };
+static const uint32_t kSidGmu[] = { 0x04, 0x05 };
+static const uint32_t kGr0Id0 = 0x20;   /* sIDR0, SMMUv2 global register space 0. Not checked against arm-smmu.h. */
+static const uint32_t kGr0Id1 = 0x24;   /* sIDR1, same. */
+
+/*
+ * attach-impl-defs (sweet.dts:10603): implementation-defined register offset and value pairs. Linux
+ * writes them when the SMMU is attached. They are listed here and not written yet.
+ */
+static const uint32_t kAttachImplDef[][2] = {
+	{ 0x6000, 0x2378 }, { 0x6060, 0x1055 }, { 0x678c, 0x08 },       { 0x6794, 0x28 },
+	{ 0x6800, 0x06 },   { 0x6900, 0x3ff },  { 0x6924, 0x204 },      { 0x6928, 0x11000 },
+	{ 0x6930, 0x800 },  { 0x6960, 0xffffffff }, { 0x6b64, 0x1a5551 }, { 0x6b68, 0x9a82a382 },
+};
+
+/* 256 KiB: the level-1 page plus 63 tables, enough for 4 KiB mappings in several 2 MiB regions. */
+static const size_t kPoolBytes = 256 * 1024;
+
+/* Boot-arg sweetmmu=1 (exact value 1), the same rule as sweetgpu=1. */
+static bool
+sweetMmuGateOpen(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetmmu", &value, (int)sizeof(value)) && value == 1;
+}
+
+SweetSmmuV2::SweetSmmuV2(void)
+    : fPool(NULL), fMmio(NULL), fTables(), fTablesReady(false)
+{
+}
+
+IOReturn
+SweetSmmuV2::allocateTables(void)
+{
+	if (fTablesReady) {
+		return kIOReturnSuccess;
+	}
+	fPool = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+	    kPoolBytes, page_size);
+	if (!fPool) {
+		return kIOReturnNoMemory;
+	}
+	fTables.va = static_cast<uint64_t *>(fPool->getBytesNoCopy());
+	fTables.pa = (uint64_t)fPool->getPhysicalAddress();
+	fTables.bytes = kPoolBytes;
+	fTables.used = 0;
+	if (sweet_pgt_init(&fTables) != kSweetPgtOk) {
+		printf("SWEET SMMU: page-table pool rejected (pa=%#llx)\n", (unsigned long long)fTables.pa);
+		OSSafeReleaseNULL(fPool);
+		fTables = SweetPgtPool();
+		return kIOReturnError;
+	}
+	fTablesReady = true;
+	printf("SWEET SMMU: page-table pool pa=%#llx bytes=%u\n", (unsigned long long)fTables.pa,
+	    (unsigned)kPoolBytes);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetSmmuV2::mapIova(uint64_t iova, IOPhysicalAddress pa, size_t len)
+{
+	/* Memory only: no SMMU register is touched, with or without sweetmmu=1. */
+	if (!fTablesReady) {
+		return kIOReturnNotReady;
+	}
+	switch (sweet_pgt_map_range(&fTables, iova, (uint64_t)pa, (uint64_t)len)) {
+	case kSweetPgtOk:
+		return kIOReturnSuccess;
+	case kSweetPgtNoMemory:
+		return kIOReturnNoMemory;
+	case kSweetPgtExists:
+		return kIOReturnExclusiveAccess;
+	case kSweetPgtRange:
+	case kSweetPgtAlign:
+		return kIOReturnBadArgument;
+	default:
+		return kIOReturnError;
+	}
+}
+
+IOReturn
+SweetSmmuV2::program(void)
+{
+	if (!sweetMmuGateOpen()) {
+		printf("SWEET SMMU: sweetmmu=1 not set; no SMMU access\n");
+		return kIOReturnOffline;
+	}
+	/* Reads only. The block is mapped by physical address, which is not a register access. */
+	if (!fMmio) {
+		IOMemoryDescriptor *desc = IOMemoryDescriptor::withPhysicalAddress(kSmmuPA, kSmmuBytes, kIODirectionInOut);
+		if (!desc) {
+			return kIOReturnNoMemory;
+		}
+		fMmio = desc->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapInhibitCache);
+		OSSafeReleaseNULL(desc);
+		if (!fMmio) {
+			printf("SWEET SMMU: block pa=%#llx map failed\n", (unsigned long long)kSmmuPA);
+			return kIOReturnNoMemory;
+		}
+	}
+	volatile uint32_t *regs = (volatile uint32_t *)fMmio->getVirtualAddress();
+	printf("SWEET SMMU: sIDR0=%#x sIDR1=%#x (reads only, pools %s)\n", regs[kGr0Id0 / 4], regs[kGr0Id1 / 4],
+	    fTablesReady ? "ready" : "not allocated");
+	for (unsigned i = 0; i < sizeof(kSidGpu) / sizeof(kSidGpu[0]); ++i) {
+		printf("SWEET SMMU: GPU stream %#x (planned, not written)\n", kSidGpu[i]);
+	}
+	for (unsigned i = 0; i < sizeof(kSidGmu) / sizeof(kSidGmu[0]); ++i) {
+		printf("SWEET SMMU: GMU stream %#x (planned, not written)\n", kSidGmu[i]);
+	}
+	for (unsigned i = 0; i < sizeof(kAttachImplDef) / sizeof(kAttachImplDef[0]); ++i) {
+		printf("SWEET SMMU: attach-impl-def %#x=%#x (not written)\n", kAttachImplDef[i][0], kAttachImplDef[i][1]);
+	}
+	printf("SWEET SMMU: stream mapping and context banks not implemented (layout unverified); no writes\n");
+	return kIOReturnUnsupported;
+}
+
+void
+SweetSmmuV2::teardown(void)
+{
+	OSSafeReleaseNULL(fMmio);
+	OSSafeReleaseNULL(fPool);
+	fTables = SweetPgtPool();
+	fTablesReady = false;
+}
+
+#endif /* SWEET */
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSmmuPgtbl.h
@@ -0,0 +1,188 @@
+/*
+ * SWEET: LPAE stage-1 page tables for the GPU SMMU (see SweetSmmuV2.h). Pure C++ with no
+ * IOKit, so the host test in session 22 compiles this same file.
+ *
+ * Format: 32-bit IOVA, 3 levels, 4 KiB granule. kgsl_smmu asks for 3-level tables
+ * (qcom,use-3-lvl-tables, sweet.dts:10595). Level 1 has 4 entries (1 GiB each); levels 2 and 3
+ * have 512 entries (2 MiB and 4 KiB). Descriptor bits (LPAE long format):
+ *   bits 1:0   0b11 = table (levels 1 and 2) or page (level 3)
+ *   bits 4:2   AttrIndx 0 (MAIR attribute 0, normal memory)
+ *   bits 7:6   AP 0 (read-write)
+ *   bits 9:8   SH 3 (inner shareable)
+ *   bit 10     AF (access flag)
+ *   bits 39:12 output address (40-bit physical)
+ *   bit 54     XN
+ * The tables live in one physically contiguous pool. The first 4 KiB page is the level-1 table.
+ * It is 4 KiB aligned, which covers the 32-byte alignment that TTBR0 needs. The rest of the pool
+ * is handed out as 4 KiB tables, zeroed when allocated.
+ */
+#ifndef _SWEET_SMMU_PGTBL_H_
+#define _SWEET_SMMU_PGTBL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum SweetPgtStatus {
+	kSweetPgtOk = 0,
+	kSweetPgtNoMemory,
+	kSweetPgtExists,
+	kSweetPgtAlign,
+	kSweetPgtRange,
+	kSweetPgtBadPool,
+	kSweetPgtUnmapped,
+};
+
+#define SWEET_PGT_PAGE       4096u
+#define SWEET_PGT_ENTRIES    512u
+#define SWEET_PGT_OA_MASK    0x000000fffffff000ull     /* bits 39:12 */
+#define SWEET_PGT_TABLE      0x3ull                    /* table descriptor, levels 1 and 2 */
+#define SWEET_PGT_PAGE_ATTR  ((1ull << 10) | (3ull << 8) | 0x3ull | (1ull << 54))
+
+struct SweetPgtPool {
+	uint64_t *va;     /* CPU address of the pool */
+	uint64_t pa;      /* physical address of the pool, 4 KiB aligned */
+	size_t bytes;     /* pool size: a multiple of 4 KiB, at least 8 KiB */
+	size_t used;      /* bytes handed out so far; the level-1 page is the first 4 KiB */
+};
+
+static inline int
+sweet_pgt_init(SweetPgtPool *p)
+{
+	if (!p->va || (p->pa & (SWEET_PGT_PAGE - 1)) || p->bytes < 2 * SWEET_PGT_PAGE ||
+	    (p->bytes & (SWEET_PGT_PAGE - 1))) {
+		return kSweetPgtBadPool;
+	}
+	for (unsigned i = 0; i < SWEET_PGT_ENTRIES; ++i) {
+		p->va[i] = 0;
+	}
+	p->used = SWEET_PGT_PAGE;
+	return kSweetPgtOk;
+}
+
+/* A table descriptor must point into the part of the pool that has been handed out. */
+static inline uint64_t *
+sweet_pgt_table_va(const SweetPgtPool *p, uint64_t descriptor)
+{
+	uint64_t tpa = descriptor & SWEET_PGT_OA_MASK;
+	if (tpa < p->pa || tpa >= p->pa + p->used || (tpa & (SWEET_PGT_PAGE - 1))) {
+		return NULL;
+	}
+	return p->va + (tpa - p->pa) / sizeof(uint64_t);
+}
+
+static inline int
+sweet_pgt_alloc(SweetPgtPool *p, uint64_t **va, uint64_t *pa)
+{
+	if (p->bytes - p->used < SWEET_PGT_PAGE) {
+		return kSweetPgtNoMemory;
+	}
+	*va = p->va + p->used / sizeof(uint64_t);
+	*pa = p->pa + p->used;
+	for (unsigned i = 0; i < SWEET_PGT_ENTRIES; ++i) {
+		(*va)[i] = 0;
+	}
+	p->used += SWEET_PGT_PAGE;
+	return kSweetPgtOk;
+}
+
+/* Maps one 4 KiB page. Only the entry it writes changes; a page that is already mapped is refused. */
+static inline int
+sweet_pgt_map_page(SweetPgtPool *p, uint64_t iova, uint64_t pa)
+{
+	if ((iova >> 32) || (pa >> 40)) {
+		return kSweetPgtRange;
+	}
+	if ((iova | pa) & (SWEET_PGT_PAGE - 1)) {
+		return kSweetPgtAlign;
+	}
+	uint64_t *l1 = p->va;
+	uint64_t *l2 = NULL, *l3 = NULL;
+	uint64_t tpa = 0;
+	unsigned i1 = (unsigned)(iova >> 30);
+	if (l1[i1] == 0) {
+		int r = sweet_pgt_alloc(p, &l2, &tpa);
+		if (r) {
+			return r;
+		}
+		l1[i1] = (tpa & SWEET_PGT_OA_MASK) | SWEET_PGT_TABLE;
+	} else {
+		l2 = sweet_pgt_table_va(p, l1[i1]);
+		if (!l2) {
+			return kSweetPgtBadPool;
+		}
+	}
+	unsigned i2 = (unsigned)((iova >> 21) & 0x1ffu);
+	if (l2[i2] == 0) {
+		int r = sweet_pgt_alloc(p, &l3, &tpa);
+		if (r) {
+			return r;
+		}
+		l2[i2] = (tpa & SWEET_PGT_OA_MASK) | SWEET_PGT_TABLE;
+	} else {
+		l3 = sweet_pgt_table_va(p, l2[i2]);
+		if (!l3) {
+			return kSweetPgtBadPool;
+		}
+	}
+	unsigned i3 = (unsigned)((iova >> 12) & 0x1ffu);
+	if (l3[i3] != 0) {
+		return kSweetPgtExists;
+	}
+	l3[i3] = (pa & SWEET_PGT_OA_MASK) | SWEET_PGT_PAGE_ATTR;
+	return kSweetPgtOk;
+}
+
+/*
+ * Maps len bytes (a multiple of 4 KiB). On an error the pages mapped before it stay mapped;
+ * the caller decides whether to unmap them (there is no unmap yet).
+ */
+static inline int
+sweet_pgt_map_range(SweetPgtPool *p, uint64_t iova, uint64_t pa, uint64_t len)
+{
+	if (!len || (len & (SWEET_PGT_PAGE - 1))) {
+		return kSweetPgtAlign;
+	}
+	for (uint64_t off = 0; off < len; off += SWEET_PGT_PAGE) {
+		int r = sweet_pgt_map_page(p, iova + off, pa + off);
+		if (r) {
+			return r;
+		}
+	}
+	return kSweetPgtOk;
+}
+
+/*
+ * Software walk over the same descriptors the SMMU reads: kSweetPgtOk and the PA (with the offset
+ * inside the page), kSweetPgtUnmapped for a hole, kSweetPgtBadPool for a broken table pointer.
+ */
+static inline int
+sweet_pgt_walk(const SweetPgtPool *p, uint64_t iova, uint64_t *pa_out)
+{
+	if (iova >> 32) {
+		return kSweetPgtRange;
+	}
+	uint64_t d1 = p->va[(unsigned)(iova >> 30)];
+	if (!d1) {
+		return kSweetPgtUnmapped;
+	}
+	const uint64_t *l2 = sweet_pgt_table_va(p, d1);
+	if (!l2) {
+		return kSweetPgtBadPool;
+	}
+	uint64_t d2 = l2[(unsigned)((iova >> 21) & 0x1ffu)];
+	if (!d2) {
+		return kSweetPgtUnmapped;
+	}
+	const uint64_t *l3 = sweet_pgt_table_va(p, d2);
+	if (!l3) {
+		return kSweetPgtBadPool;
+	}
+	uint64_t d3 = l3[(unsigned)((iova >> 12) & 0x1ffu)];
+	if (!(d3 & 0x3ull)) {
+		return kSweetPgtUnmapped;
+	}
+	*pa_out = (d3 & SWEET_PGT_OA_MASK) | (iova & (SWEET_PGT_PAGE - 1));
+	return kSweetPgtOk;
+}
+
+#endif /* _SWEET_SMMU_PGTBL_H_ */
