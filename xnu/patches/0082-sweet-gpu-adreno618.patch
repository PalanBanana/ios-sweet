@@ -0,0 +1,235 @@
+/*
+ * SWEET: Adreno 618 bring-up (see SweetGPU.h).
+ *
+ * Register offsets marked VERIFY come from the brief, not from a6xx.xml.h,
+ * and are not checked. Gated by boot-arg sweetgpu=1: without it the driver
+ * maps the block and logs the identity register only.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOMapper.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include "SweetGPU.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(MsmGpuAdreno618, IOService)
+
+/*
+ * Dword indices, as in Mesa src/freedreno/registers/adreno/a6xx.xml and
+ * adreno_common.xml. Byte offset = index * 4. Kernel: adreno_gpu.h:766
+ * (gpu->mmio + (addr << 2)). Entries marked (64) are reg64 (lo at index,
+ * hi at index+1).
+ */
+enum {
+	kRbbmStatus        = 0x0210,  /* a6xx.xml:554 RBBM_STATUS */
+	kRbbmSwResetCmd    = 0x0043,  /* a6xx.xml:806 RBBM_SW_RESET_CMD */
+	kRbbmInt0Mask      = 0x0038,  /* a6xx.xml:801 RBBM_INT_0_MASK */
+	kRbbmInt0Status    = 0x0201,  /* a6xx.xml:552 RBBM_INT_0_STATUS */
+	kGbifScache0       = 0x3c01,  /* a6xx.xml:1273 GBIF_SCACHE_CNTL0 (rmw in kernel, value unconfirmed) */
+	kGbifScache1       = 0x3c02,  /* a6xx.xml:1274 GBIF_SCACHE_CNTL1 (rmw in kernel, value unconfirmed) */
+	kCpRbBase          = 0x0800,  /* a6xx.xml:147 CP_RB_BASE (64) */
+	kCpRbCntl          = 0x0802,  /* a6xx.xml:148 CP_RB_CNTL */
+	kCpRbRptrAddr     = 0x0804,  /* a6xx.xml:150 CP_RB_RPTR_ADDR (64) */
+	kCpRbRptr          = 0x0806,  /* a6xx.xml:151 CP_RB_RPTR */
+	kCpRbWptr          = 0x0807,  /* a6xx.xml:152 CP_RB_WPTR */
+	kCpIntCntl         = 0x01f2,  /* adreno_common.xml:184 CP_INT_CNTL (not redefined in a6xx.xml) */
+	kCpMeCntl          = 0x01f6,  /* adreno_common.xml:197 CP_ME_CNTL */
+	kCpMeStatus        = 0x01f7,  /* adreno_common.xml:201 CP_ME_STATUS */
+	kGpuIdentity       = 0x0000,  /* VERIFY (미확정): no chip-id register found in a6xx.xml */
+};
+
+/* a6xx.xml:554 RBBM_STATUS bit 0 = CP_AHB_BUSY_CX_MASTER (ignored for idle) */
+static const uint32_t kRbbmStatusCxAhbBusy = 1u << 0;
+
+static const uint32_t kRingBytes = 64 * 1024;
+static const uint32_t kZapBytes  = 64 * 1024;
+
+uint32_t MsmGpuAdreno618::readReg(uint32_t idx)
+{
+	return fRegs[idx];
+}
+
+void MsmGpuAdreno618::writeReg(uint32_t idx, uint32_t val)
+{
+	fRegs[idx] = val;
+}
+
+bool MsmGpuAdreno618::init(OSDictionary *dict)
+{
+	if (!super::init(dict)) {
+		return false;
+	}
+	fMmio = NULL;
+	fRegs = NULL;
+	fRingBuf = NULL;
+	fZapBuf = NULL;
+	fRingWptr = 0;
+	fFence = 0;
+	fReady = false;
+	return true;
+}
+
+IOService *MsmGpuAdreno618::probe(IOService *provider, SInt32 *score)
+{
+	IOService *ret = super::probe(provider, score);
+	printf("SWEET GPU: probe provider=%s\n", provider ? provider->getName() : "?");
+	return ret;
+}
+
+bool MsmGpuAdreno618::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	/* Map GPU MMIO (reg index 0 from the device-tree node). */
+	fMmio = provider->mapDeviceMemoryWithIndex(0);
+	if (!fMmio) {
+		printf("SWEET GPU: mapDeviceMemoryWithIndex(0) failed\n");
+		return false;
+	}
+	fRegs = (volatile uint32_t *)fMmio->getVirtualAddress();
+	printf("SWEET GPU: mmio va=%p len=%llu\n", fRegs,
+	    (unsigned long long)fMmio->getLength());
+
+	/* identity register not read: no chip-id offset confirmed (미확정) */
+	printf("SWEET GPU: mmio mapped (identity not read: 미확정)\n");
+
+	if (!PE_parse_boot_argn("sweetgpu", NULL, 0)) {
+		printf("SWEET GPU: sweetgpu=1 not set; leaving hardware untouched\n");
+		registerService();
+		return true;
+	}
+
+	if (powerUpSequence() != kIOReturnSuccess) {
+		printf("SWEET GPU: power-up failed\n");
+		OSSafeReleaseNULL(fMmio);
+		return false;
+	}
+	if (loadZapFirmware() != kIOReturnSuccess) {
+		printf("SWEET GPU: zap firmware missing; GPU not ready\n");
+		return false;
+	}
+	if (initRingbuffer() != kIOReturnSuccess) {
+		printf("SWEET GPU: ring buffer init failed\n");
+		return false;
+	}
+	fReady = true;
+	printf("SWEET GPU: ready\n");
+	registerService();
+	return true;
+}
+
+bool MsmGpuAdreno618::waitIdle(uint32_t timeoutUs)
+{
+	uint64_t deadline = mach_absolute_time() +
+	    (uint64_t)timeoutUs * 24;  /* ~24 MHz timebase, VERIFY */
+	while (mach_absolute_time() < deadline) {
+		/* a6xx_gpu.c:128: idle when RBBM_STATUS & ~CP_AHB_BUSY_CX_MASTER == 0 */
+		if (!(readReg(kRbbmStatus) & ~kRbbmStatusCxAhbBusy)) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}
+
+IOReturn MsmGpuAdreno618::powerUpSequence(void)
+{
+	/* a6xx_gpu_sw_reset(): assert then deassert RBBM_SW_RESET_CMD (a6xx_gpu.c:2128-2131) */
+	writeReg(kRbbmSwResetCmd, 1);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+	writeReg(kRbbmSwResetCmd, 0);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+
+	/* 0 = all RBBM_INT_0 sources masked (a6xx_gpu.c:1849 writes 0). */
+	writeReg(kRbbmInt0Mask, 0);
+
+	/*
+	 * Not written here (미확정): GBIF_SCACHE_CNTL0/1 values (kernel uses
+	 * read-modify-write, a6xx_gpu.c:1989-2050) and the CP mode registers.
+	 */
+	if (!waitIdle(100000)) {
+		printf("SWEET GPU: RBBM not idle after reset\n");
+		return kIOReturnTimeout;
+	}
+	printf("SWEET GPU: power-up done, RBBM_STATUS=%#x\n", readReg(kRbbmStatus));
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::loadZapFirmware(void)
+{
+	/*
+	 * The zap shader (a615_zap.mbn) is in the Android vendor partition.
+	 * The shim is expected to place it at the reserved DRAM range that the
+	 * ADT node /arm-io/gpu-zap describes (not yet in mkadt.py). Until that
+	 * exists this returns an error, so the GPU never runs unsigned code.
+	 */
+	fZapBuf = IOBufferMemoryDescriptor::withOptions(
+	    kIODirectionInOut | kIOMemoryKernelUserShared, kZapBytes, page_size);
+	if (!fZapBuf) {
+		return kIOReturnNoMemory;
+	}
+	if (!PE_parse_boot_argn("sweetgpuzap", NULL, 0)) {
+		printf("SWEET GPU: zap blob not provided (sweetgpuzap unset)\n");
+		OSSafeReleaseNULL(fZapBuf);
+		return kIOReturnNotFound;
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::initRingbuffer(void)
+{
+	fRingBuf = IOBufferMemoryDescriptor::withOptions(
+	    kIODirectionInOut | kIOMemoryKernelUserShared, kRingBytes, page_size);
+	if (!fRingBuf) {
+		return kIOReturnNoMemory;
+	}
+	uint64_t ringPA = (uint64_t)fRingBuf->getPhysicalAddress();
+	/* gpu_write64(CP_RB_BASE) at a6xx_gpu.c:1446: lo at index, hi at index+1 */
+	writeReg(kCpRbBase, (uint32_t)ringPA);
+	writeReg(kCpRbBase + 1, (uint32_t)(ringPA >> 32));
+	/*
+	 * 미확정: CP_RB_CNTL value (MSM_GPU_RB_CNTL_DEFAULT, a6xx_gpu.c:1453)
+	 * is defined outside the fetched files, so it is not written here.
+	 */
+	fRingWptr = 0;
+	writeReg(kCpRbWptr, 0);
+	printf("SWEET GPU: ring PA=%#llx (CP_RB_CNTL not written, 미확정)\n",
+	    (unsigned long long)ringPA);
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::submitFrame(uint64_t surfacePA, uint32_t bytes,
+    uint32_t *fenceOut)
+{
+	/*
+	 * 미확정: a frame is not a CP_MEM_TO_MEM. That packet copies dwords
+	 * (adreno_pm4.xml:1368, DST + SRC_A addresses), so it cannot move a
+	 * surface. Real submission needs a command stream (CP_INDIRECT_BUFFER)
+	 * and a fence. Not implemented until that design exists.
+	 */
+	(void)surfacePA;
+	(void)bytes;
+	(void)fenceOut;
+	return kIOReturnUnsupported;
+}
+
+void MsmGpuAdreno618::stop(IOService *provider)
+{
+	/* 0 masks all RBBM_INT_0 sources (a6xx_gpu.c:1849); ~0u would enable them */
+	writeReg(kRbbmInt0Mask, 0);
+	super::stop(provider);
+}
+
+void MsmGpuAdreno618::free(void)
+{
+	OSSafeReleaseNULL(fRingBuf);
+	OSSafeReleaseNULL(fZapBuf);
+	OSSafeReleaseNULL(fMmio);
+	super::free();
+}
