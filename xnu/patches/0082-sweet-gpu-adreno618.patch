+/*
+ * SWEET: Adreno 618 (SM7150, a6xx) bring-up driver for XNU IOKit.
+ *
+ * Status: skeleton. start() maps the GPU MMIO block and performs no
+ * register access. Power-up, ring buffer and zap loading run only with
+ * boot-arg sweetgpu=1. Register offsets and the CP_RB_CNTL default are
+ * checked against Mesa a6xx.xml and msm_gpu.h. Items still open for hardware
+ * bring-up (GBIF LLCC slice, NO_UPDATE choice, frame submission) are marked
+ * 미확정 in SweetGPU.cpp. A frame submission path needs a command-stream
+ * design (see submitFrame).
+ */
+#ifndef _SWEET_GPU_ADRENO618_H_
+#define _SWEET_GPU_ADRENO618_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class MsmGpuAdreno618 : public IOService {
+	OSDeclareDefaultStructors(MsmGpuAdreno618);
+
+private:
+	IOMemoryMap                 *fMmio;        /* GPU register block */
+	volatile uint32_t           *fRegs;
+	IOBufferMemoryDescriptor    *fRingBuf;     /* 64 KiB command ring */
+	IOBufferMemoryDescriptor    *fZapBuf;      /* 64 KiB zap firmware */
+	uint32_t                    fRingWptr;
+	uint32_t                    fFence;
+	bool                        fReady;
+
+	uint32_t readReg(uint32_t off);
+	void     writeReg(uint32_t off, uint32_t val);
+
+	IOReturn powerUpSequence(void);
+	IOReturn initRingbuffer(void);
+	IOReturn loadZapFirmware(void);
+	bool     waitIdle(uint32_t timeoutUs);
+
+public:
+	virtual bool     init(OSDictionary *dict = NULL) override;
+	virtual IOService *probe(IOService *provider, SInt32 *score) override;
+	virtual bool     start(IOService *provider) override;
+	virtual void     stop(IOService *provider) override;
+	virtual void     free(void) override;
+
+	/*
+	 * Frame submission. 미확정: returns kIOReturnUnsupported until a command
+	 * stream (CP_INDIRECT_BUFFER) and fence design exists. CP_MEM_TO_MEM
+	 * copies dwords and cannot move a surface (adreno_pm4.xml:1368).
+	 */
+	IOReturn submitFrame(uint64_t surfacePA, uint32_t bytes, uint32_t *fenceOut);
+};
+
+#endif /* _SWEET_GPU_ADRENO618_H_ */
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -0,0 +1,252 @@
+/*
+ * SWEET: Adreno 618 bring-up (see SweetGPU.h).
+ *
+ * Offsets: Mesa a6xx.xml / adreno_common.xml (dword indices), checked in
+ * the P0 pass. Gated by boot-arg sweetgpu=1: without it the driver maps the
+ * block and performs no register access. Items still open for hardware
+ * bring-up are marked 미확정 with the reason.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOMapper.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include "SweetGPU.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(MsmGpuAdreno618, IOService)
+
+/*
+ * Boot-arg gate: only the exact value 1 opens it. The buffer is int64_t and
+ * max_len is 8, because argnumcpy stores (int32_t)val at max_len 4, so
+ * sweetgpu=4294967297 would read back as 1 (bootargs.c:362). A bare name, or any value that is not
+ * the number 1, keeps the gate closed.
+ */
+static bool
+sweetGpuGateOpen(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetgpu", &value, (int)sizeof(value)) && value == 1;
+}
+
+/*
+ * Dword indices, as in Mesa src/freedreno/registers/adreno/a6xx.xml and
+ * adreno_common.xml. Byte offset = index * 4. Kernel: adreno_gpu.h:766
+ * (gpu->mmio + (addr << 2)). Entries marked (64) are reg64 (lo at index,
+ * hi at index+1).
+ */
+enum {
+	kRbbmStatus        = 0x0210,  /* a6xx.xml:554 RBBM_STATUS */
+	kRbbmSwResetCmd    = 0x0043,  /* a6xx.xml:806 RBBM_SW_RESET_CMD */
+	kRbbmInt0Mask      = 0x0038,  /* a6xx.xml:801 RBBM_INT_0_MASK */
+	kRbbmInt0Status    = 0x0201,  /* a6xx.xml:552 RBBM_INT_0_STATUS */
+	kGbifScache0       = 0x3c01,  /* a6xx.xml:1273 GBIF_SCACHE_CNTL0 (rmw in kernel, value unconfirmed) */
+	kGbifScache1       = 0x3c02,  /* a6xx.xml:1274 GBIF_SCACHE_CNTL1 (rmw in kernel, value unconfirmed) */
+	kCpRbBase          = 0x0800,  /* a6xx.xml:147 CP_RB_BASE (64) */
+	kCpRbCntl          = 0x0802,  /* a6xx.xml:148 CP_RB_CNTL */
+	kCpRbRptrAddr     = 0x0804,  /* a6xx.xml:150 CP_RB_RPTR_ADDR (64) */
+	kCpRbRptr          = 0x0806,  /* a6xx.xml:151 CP_RB_RPTR */
+	kCpRbWptr          = 0x0807,  /* a6xx.xml:152 CP_RB_WPTR */
+	kCpIntCntl         = 0x01f2,  /* adreno_common.xml:184 CP_INT_CNTL (not redefined in a6xx.xml) */
+	kCpMeCntl          = 0x01f6,  /* adreno_common.xml:197 CP_ME_CNTL */
+	kCpMeStatus        = 0x01f7,  /* adreno_common.xml:201 CP_ME_STATUS */
+};
+
+/* a6xx.xml:554 RBBM_STATUS bit 0 = CP_AHB_BUSY_CX_MASTER (ignored for idle) */
+static const uint32_t kRbbmStatusCxAhbBusy = 1u << 0;
+
+static const uint32_t kRingBytes = 64 * 1024;
+static const uint32_t kZapBytes  = 64 * 1024;
+
+uint32_t MsmGpuAdreno618::readReg(uint32_t idx)
+{
+	return fRegs[idx];
+}
+
+void MsmGpuAdreno618::writeReg(uint32_t idx, uint32_t val)
+{
+	fRegs[idx] = val;
+}
+
+bool MsmGpuAdreno618::init(OSDictionary *dict)
+{
+	if (!super::init(dict)) {
+		return false;
+	}
+	fMmio = NULL;
+	fRegs = NULL;
+	fRingBuf = NULL;
+	fZapBuf = NULL;
+	fRingWptr = 0;
+	fFence = 0;
+	fReady = false;
+	return true;
+}
+
+IOService *MsmGpuAdreno618::probe(IOService *provider, SInt32 *score)
+{
+	IOService *ret = super::probe(provider, score);
+	printf("SWEET GPU: probe provider=%s\n", provider ? provider->getName() : "?");
+	return ret;
+}
+
+bool MsmGpuAdreno618::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	/* Map GPU MMIO (reg index 0 from the device-tree node). */
+	fMmio = provider->mapDeviceMemoryWithIndex(0);
+	if (!fMmio) {
+		printf("SWEET GPU: mapDeviceMemoryWithIndex(0) failed\n");
+		return false;
+	}
+	fRegs = (volatile uint32_t *)fMmio->getVirtualAddress();
+	printf("SWEET GPU: mmio va=%p len=%llu\n", fRegs,
+	    (unsigned long long)fMmio->getLength());
+
+	/* identity register not read: no chip-id offset confirmed (미확정) */
+	printf("SWEET GPU: mmio mapped (identity not read: 미확정)\n");
+
+	/* VALUE checked: only sweetgpu=1 enables unverified MMIO writes */
+	if (!sweetGpuGateOpen()) {
+		printf("SWEET GPU: sweetgpu=1 not set; leaving hardware untouched\n");
+		registerService();
+		return true;
+	}
+
+	/* Zap loads before any register write: no firmware, no MMIO writes. */
+	if (loadZapFirmware() != kIOReturnSuccess) {
+		printf("SWEET GPU: zap firmware unavailable; GPU not started\n");
+		OSSafeReleaseNULL(fMmio);
+		return false;
+	}
+	if (powerUpSequence() != kIOReturnSuccess) {
+		printf("SWEET GPU: power-up failed\n");
+		OSSafeReleaseNULL(fMmio);
+		return false;
+	}
+	if (initRingbuffer() != kIOReturnSuccess) {
+		printf("SWEET GPU: ring buffer init failed\n");
+		OSSafeReleaseNULL(fMmio);
+		return false;
+	}
+	fReady = true;
+	printf("SWEET GPU: ready\n");
+	registerService();
+	return true;
+}
+
+bool MsmGpuAdreno618::waitIdle(uint32_t timeoutUs)
+{
+	/* Poll with a fixed delay instead of a timebase: the tick rate is not
+	 * verified for this board. */
+	for (uint32_t waited = 0; waited < timeoutUs; waited += 10) {
+		/* a6xx_gpu.c:128: idle when RBBM_STATUS & ~CP_AHB_BUSY_CX_MASTER == 0 */
+		if (!(readReg(kRbbmStatus) & ~kRbbmStatusCxAhbBusy)) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}
+
+IOReturn MsmGpuAdreno618::powerUpSequence(void)
+{
+	/* a6xx_gpu_sw_reset(): assert then deassert RBBM_SW_RESET_CMD (a6xx_gpu.c:2128-2131) */
+	writeReg(kRbbmSwResetCmd, 1);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+	writeReg(kRbbmSwResetCmd, 0);
+	(void)readReg(kRbbmSwResetCmd);
+	IODelay(1);
+
+	/* 0 = all RBBM_INT_0 sources masked (a6xx_gpu.c:1849 writes 0). */
+	writeReg(kRbbmInt0Mask, 0);
+
+	/*
+	 * Not written here: GBIF_SCACHE_CNTL0/1. The kernel computes these from a
+	 * runtime LLCC slice id (gpu_scid, a6xx_gpu.c:1980-2050), which this
+	 * board has not provided. 미확정 until hardware bring-up.
+	 */
+	if (!waitIdle(100000)) {
+		printf("SWEET GPU: RBBM not idle after reset\n");
+		return kIOReturnTimeout;
+	}
+	printf("SWEET GPU: power-up done, RBBM_STATUS=%#x\n", readReg(kRbbmStatus));
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::loadZapFirmware(void)
+{
+	/*
+	 * Not implemented. a615_zap.mbn is in the Android vendor partition, which
+	 * this machine cannot read. A success return here would mark the GPU ready
+	 * without firmware, so this always fails.
+	 */
+	printf("SWEET GPU: zap loader not implemented; refusing to start\n");
+	return kIOReturnUnsupported;
+}
+
+IOReturn MsmGpuAdreno618::initRingbuffer(void)
+{
+	fRingBuf = IOBufferMemoryDescriptor::withOptions(
+	    kIODirectionInOut | kIOMemoryKernelUserShared, kRingBytes, page_size);
+	if (!fRingBuf) {
+		return kIOReturnNoMemory;
+	}
+	uint64_t ringPA = (uint64_t)fRingBuf->getPhysicalAddress();
+	/* gpu_write64(CP_RB_BASE) at a6xx_gpu.c:1446: lo at index, hi at index+1 */
+	writeReg(kCpRbBase, (uint32_t)ringPA);
+	writeReg(kCpRbBase + 1, (uint32_t)(ringPA >> 32));
+	/*
+	 * MSM_GPU_RB_CNTL_DEFAULT = BUFSZ(ilog2(SZ_32K/8)=12) | BLKSZ(ilog2(32/8)=2)
+	 *   = 0x20C  (msm_gpu.h:306-311; adreno_common.xml:138-141 field layout)
+	 * The kernel ORs AXXX_CP_RB_CNTL_NO_UPDATE (bit 27) only when
+	 * !hw_apriv (a6xx_gpu.c:1453-1455). That choice is 미확정 and depends on
+	 * the GPU's apriv capability: resolve at hardware bring-up.
+	 */
+	writeReg(kCpRbCntl, 0x20C);
+	fRingWptr = 0;
+	writeReg(kCpRbWptr, 0);
+	printf("SWEET GPU: ring PA=%#llx (CP_RB_CNTL=0x20C, NO_UPDATE 미확정)\n",
+	    (unsigned long long)ringPA);
+	return kIOReturnSuccess;
+}
+
+IOReturn MsmGpuAdreno618::submitFrame(uint64_t surfacePA, uint32_t bytes,
+    uint32_t *fenceOut)
+{
+	/*
+	 * 미확정: a frame is not a CP_MEM_TO_MEM. That packet copies dwords
+	 * (adreno_pm4.xml:1368, DST + SRC_A addresses), so it cannot move a
+	 * surface. Real submission needs a command stream (CP_INDIRECT_BUFFER)
+	 * and a fence. Not implemented until that design exists.
+	 */
+	(void)surfacePA;
+	(void)bytes;
+	(void)fenceOut;
+	return kIOReturnUnsupported;
+}
+
+void MsmGpuAdreno618::stop(IOService *provider)
+{
+	/* 0 masks all RBBM_INT_0 sources (a6xx_gpu.c:1849); ~0u would enable them */
+	writeReg(kRbbmInt0Mask, 0);
+	super::stop(provider);
+}
+
+void MsmGpuAdreno618::free(void)
+{
+	OSSafeReleaseNULL(fRingBuf);
+	OSSafeReleaseNULL(fZapBuf);
+	OSSafeReleaseNULL(fMmio);
+	super::free();
+}
+
+#endif /* SWEET */
