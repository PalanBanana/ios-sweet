+/*
+ * SWEET: Adreno 618 bring-up (see SweetGPU.h).
+ *
+ * Source of each value: sweet.dts GPU node (qcom,kgsl-3d0@5000000, lines
+ * 17748-18197), Mesa a6xx.xml and adreno_common.xml (register offsets as dword
+ * indices), and Linux a6xx_gpu.c where noted. Every register access sits behind
+ * boot-arg sweetgpu=1. Without it, start() maps the GPU block and nothing else.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOMapper.h>
+#include <libkern/libkern.h>
+#include <kern/clock.h>
+#include <kern/task.h>
+#include <pexpert/pexpert.h>
+#include "SweetGPU.h"
+#include "SweetSmmuV2.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(MsmGpuAdreno618, IOService)
+
+/*
+ * Boot-arg gate: only the exact value 1 opens it. The buffer is int64_t with
+ * max_len 8. At max_len 4, argnumcpy keeps only the low 32 bits
+ * (pexpert/gen/bootargs.c:379), so sweetgpu=4294967297 would read back as 1. A bare name or any other value
+ * keeps the gate closed.
+ */
+static bool
+sweetGpuGateOpen(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetgpu", &value, (int)sizeof(value)) && value == 1;
+}
+
+/*
+ * Reg windows: sweet.dts:17752 reg = <0x5000000 0x40000 0x5061000 0x800
+ * 0x509e000 0x1000 0x780000 0x6300>, named at 17753. Mapping goes by index.
+ * The sizes are the minimum that each mapping must cover.
+ */
+static const uint64_t kGpuRegBytes = 0x40000;   /* 0: kgsl_3d0_reg_memory */
+static const uint64_t kCxDbgcBytes = 0x800;     /* 1: cx_dbgc */
+static const uint64_t kCxMiscBytes = 0x1000;    /* 2: cx_misc */
+static const uint64_t kQfpromBytes = 0x6300;    /* 3: qfprom_memory */
+
+/* sweet.dts:17754 interrupts = <0 0x12c 4>: SPI 300, level-high. Source 0 of the provider. */
+static const int kGpuIrqSource = 0;
+
+/* sweet.dts:17757 qcom,chipid = <0x6010800>. 미확정: not read, Mesa has no chip-ID register. */
+static const uint32_t kChipIdDt = 0x06010800;
+
+/* sweet.dts:17783 qcom,gpu-speed-bin = <0x41a0 0x1fe00000 0x15>: byte offset, mask, shift in qfprom. */
+static const uint32_t kSpeedBinOff = 0x41a0;
+static const uint32_t kSpeedBinMask = 0x1fe00000;
+static const uint32_t kSpeedBinShift = 21;
+
+/* readFuse indexes qfprom by dword (byteOff / 4), so the offset must be 4-byte aligned: 0x41a0 = 16800 = 4 * 4200. */
+static_assert(kSpeedBinOff % 4 == 0, "qfprom speed-bin offset must be 4-byte aligned");
+
+/* MSM_GPU_RINGBUFFER_SZ = SZ_32K (msm_gpu.h:306). The control value below encodes that size. */
+static const uint32_t kRingBytes = 32 * 1024;
+static const uint32_t kRbCntlDefault = 0x20C;   /* MSM_GPU_RB_CNTL_DEFAULT, msm_gpu.h:309-311 */
+/* AXXX_CP_RB_CNTL_NO_UPDATE, bit 27 (Mesa adreno_common.xml:143). Linux sets it when hw_apriv is 0 (a6xx_gpu.c:1452-1456). */
+static const uint32_t kRbCntlNoUpdate = 1u << 27;
+
+/* sweet.dts:18182 qcom,gpu-pwrlevel@7 = "\bX;": a string, not a frequency. */
+static const uint32_t kPwrSentinel = 0xFFFFFFFFu;
+
+/*
+ * Frequency tables from sweet.dts gpu-pwrlevel-bins (starts at line 17816), in Hz
+ * exactly as the DT gives them. Level 0 is the fastest. The bin for a speed bin is
+ * selected at start(); the clock is not programmed (미확정).
+ */
+static const SweetGpuPwrBin kPwrBins[] = {
+	/* sweet.dts:17821 */
+	{ 0x00, 7, 5, 9, { 825000000, 800000000, 650000000, 565000000, 430000000,
+	    355000000, 267000000, 180000000, 0 } },
+	/* sweet.dts:17901 */
+	{ 0xac, 7, 5, 9, { 825000000, 800000000, 650000000, 565000000, 430000000,
+	    355000000, 267000000, 180000000, 0 } },
+	/* sweet.dts:17981 */
+	{ 0x92, 6, 4, 8, { 700000000, 650000000, 565000000, 430000000, 355000000,
+	    267000000, 180000000, 0 } },
+	/* sweet.dts:18053 */
+	{ 0x80, 5, 3, 7, { 610000000, 565000000, 430000000, 355000000, 267000000,
+	    180000000, 0 } },
+	/* sweet.dts:18117: level 7 is kPwrSentinel and initLevel is 7 (미확정) */
+	{ 0xa7, 7, 4, 9, { 800000000, 650000000, 565000000, 430000000, 355000000,
+	    267000000, 180000000, kPwrSentinel, 0 } },
+};
+
+/*
+ * Register offsets as dword indices (byte offset = index * 4), the convention of
+ * Mesa and Linux (adreno_gpu.h:766). Entries marked (64) are reg64: lo at the
+ * index, hi at index+1.
+ */
+enum {
+	kRbbmStatus          = 0x0210,  /* a6xx.xml:554 RBBM_STATUS */
+	kRbbmSwResetCmd      = 0x0043,  /* a6xx.xml:806 RBBM_SW_RESET_CMD */
+	kRbbmInt0Mask        = 0x0038,  /* a6xx.xml:801 RBBM_INT_0_MASK */
+	kRbbmInt0Status      = 0x0201,  /* a6xx.xml:552 RBBM_INT_0_STATUS */
+	kRbbmSecvidTrustCntl = 0xF400,  /* a6xx.xml:775 RBBM_SECVID_TRUST_CNTL */
+	/* TSB and ADDR_MODE (Linux a6xx_gpu.c:1210-1236). Mesa offsets are dword indices. */
+	kRbbmSecvidTsbCntl          = 0xF803,  /* a6xx.xml:778 RBBM_SECVID_TSB_CNTL, Linux 1210 */
+	kRbbmSecvidTsbTrustedBase   = 0xF800,  /* a6xx.xml:776 RBBM_SECVID_TSB_TRUSTED_BASE (reg64, hi at +1), Linux 1220 */
+	kRbbmSecvidTsbTrustedSize   = 0xF802,  /* a6xx.xml:777 RBBM_SECVID_TSB_TRUSTED_SIZE, Linux 1221 */
+	kCpAddrModeCntl             = 0x0842,  /* a6xx.xml:270 CP_ADDR_MODE_CNTL, Linux 1225 */
+	kVscAddrModeCntl            = 0x0C01,  /* a6xx.xml:550 VSC_ADDR_MODE_CNTL, Linux 1226 */
+	kGrasAddrModeCntl           = 0x8601,  /* a6xx.xml:2219 GRAS_ADDR_MODE_CNTL, Linux 1227 */
+	kRbAddrModeCntl             = 0x8E05,  /* a6xx.xml:2840 RB_ADDR_MODE_CNTL, Linux 1228 */
+	kPcAddrModeCntl             = 0x9E01,  /* a6xx.xml:3464 PC_ADDR_MODE_CNTL, Linux 1229 */
+	kHlsqAddrModeCntl           = 0xBE05,  /* a6xx.xml:5009 HLSQ_ADDR_MODE_CNTL, Linux 1230 */
+	kVfdAddrModeCntl            = 0xA601,  /* a6xx.xml:3613 VFD_ADDR_MODE_CNTL, Linux 1231 */
+	kVpcAddrModeCntl            = 0x9601,  /* a6xx.xml:3257 VPC_ADDR_MODE_CNTL, Linux 1232 */
+	kUcheAddrModeCntl           = 0x0E00,  /* a6xx.xml:1202 UCHE_ADDR_MODE_CNTL, Linux 1233 */
+	kSpAddrModeCntl             = 0xAE01,  /* a6xx.xml:4364 SP_ADDR_MODE_CNTL, Linux 1234 */
+	kTpl1AddrModeCntl           = 0xB601,  /* a6xx.xml:4587 TPL1_ADDR_MODE_CNTL, Linux 1235 */
+	kRbbmSecvidTsbAddrModeCntl  = 0xF810,  /* a6xx.xml:779 RBBM_SECVID_TSB_ADDR_MODE_CNTL, Linux 1236 */
+	kGbifScache0         = 0x3c01,  /* a6xx.xml:1273 GBIF_SCACHE_CNTL0 (rmw in kernel, value unconfirmed) */
+	kGbifScache1         = 0x3c02,  /* a6xx.xml:1274 GBIF_SCACHE_CNTL1 (rmw in kernel, value unconfirmed) */
+	kCpRbBase            = 0x0800,  /* a6xx.xml:147 CP_RB_BASE (64) */
+	kCpRbCntl            = 0x0802,  /* a6xx.xml:148 CP_RB_CNTL */
+	kCpRbRptrAddr        = 0x0804,  /* a6xx.xml:150 CP_RB_RPTR_ADDR (64) */
+	kCpRbRptr            = 0x0806,  /* a6xx.xml:151 CP_RB_RPTR */
+	kCpRbWptr            = 0x0807,  /* a6xx.xml:152 CP_RB_WPTR */
+	kCpIntCntl           = 0x01f2,  /* adreno_common.xml:184 CP_INT_CNTL (not redefined in a6xx.xml) */
+	kCpMeCntl            = 0x01f6,  /* adreno_common.xml:197 CP_ME_CNTL */
+	kCpMeStatus          = 0x01f7,  /* adreno_common.xml:201 CP_ME_STATUS */
+	kCpProtectCntl       = 0x084F,  /* a6xx.xml:281 CP_PROTECT_CNTL */
+	kCpProtectBase       = 0x0850,  /* a6xx.xml:294 CP_PROTECT array, stride 1, length 32 */
+};
+
+/* a6xx.xml:554 RBBM_STATUS bit 0 = CP_AHB_BUSY_CX_MASTER (ignored for idle) */
+static const uint32_t kRbbmStatusCxAhbBusy = 1u << 0;
+
+/* a5xx_address_mode ADDR_64B (adreno_common.xml:390): value for the TSB and ADDR_MODE writes. */
+static const uint32_t kAddrMode64 = 1;
+
+/*
+ * CP_PROTECT_CNTL = ACCESS_PROT_EN (bit 0) | ACCESS_FAULT_ON_VIOL_EN (bit 1) |
+ * LAST_SPAN_INF_RANGE (bit 3). a6xx.xml:275-279, Linux a6xx_gpu.c:734-737.
+ */
+static const uint32_t kCpProtectCntlVal = 0xB;
+static const uint32_t kCpProtectCount = 32;     /* a6xx.xml:294 length 32 */
+
+/*
+ * GX GDSC status, read only (Linux gdsc.c). sweet.dts:6172-6186 gpu_gx_gdsc, reg
+ * 0x509100c = gpucc + 0x100c (gpucc-sm8150.c:233 .gdscr = 0x100c). Its node has
+ * qcom,poll-cfg-gdscr (sweet.dts:6176), so Linux reads the status from CFG_GDSCR,
+ * GDSCR + 0x4 (gdsc.c:67-68), and tests GDSC_POWER_UP_COMPLETE there (gdsc.c:78-81).
+ * PWR_ON (bit 31) is the status of a non-polling GDSC (gdsc.c:89).
+ */
+static const uint64_t kGpuccPA = 0x5090000;    /* sweet.dts:634 gpucc reg base */
+static const uint64_t kGpuccBytes = 0x1014;    /* covers CFG_GDSCR at 0x1010 */
+static const uint32_t kGdscOff = 0x100C;       /* GX GDSCR, offset from kGpuccPA */
+static const uint32_t kGdscCfgOff = 0x1010;    /* CFG_GDSCR = GDSCR + CFG_GDSCR_OFFSET (gdsc.c:35) */
+static const uint32_t kGdscPwrOn = 1u << 31;   /* PWR_ON_MASK (gdsc.c:21) */
+static const uint32_t kGdscPowerUpComplete = 1u << 16;   /* GDSC_POWER_UP_COMPLETE (gdsc.c:32) */
+static_assert(kGdscOff % 4 == 0 && kGdscCfgOff % 4 == 0, "gpucc GDSC offsets must be 4-byte aligned");
+static_assert(kGdscCfgOff == kGdscOff + 4, "CFG_GDSCR is GDSCR + 0x4 (gdsc.c:35)");
+
+/*
+ * GMU register block: mapped by physical address, not accessed (session 21, Task C).
+ * sweet.dts:18230 gmu node (qcom,gmu@506a000), reg-names[0] "kgsl_gmu_reg" =
+ * <0x506a000 0x31000>. The PDC ranges 0xb290000 and 0xb490000 are not mapped here.
+ * The start is 4 KiB aligned but not 16 KiB aligned, and this port uses 16 KiB pages
+ * (NOTES.md, Milestone 3). Check the VA printed by mapPhysical against the PA before
+ * any GMU access.
+ */
+static const uint64_t kGmuPA = 0x506a000;
+static const uint64_t kGmuBytes = 0x31000;
+static_assert(kGmuPA + kGmuBytes <= 0xB290000, "GMU block ends below the PDC ranges (sweet.dts:18230)");
+
+/*
+ * a630_protect_regs (Linux a6xx_catalog.c:508-541), the table of both 0x06010800
+ * catalog entries (a6xx_catalog.c:777, :802). A6XX_PROTECT_RDONLY = len << 18 | reg,
+ * A6XX_PROTECT_NORDWR = 1 << 31 | len << 18 | reg (a6xx_gpu.h:228-238). Entry 31 is
+ * the infinite last span. Linux skips zero values (a6xx_gpu.c:741); none is zero.
+ * The values are generated from the catalog macros.
+ */
+static const uint32_t kCpProtectRegs[kCpProtectCount] = {
+	0x13fc0000, /* RDONLY 0x00000 len 0x04ff, a6xx_catalog.c:509 */
+	0x00140501, /* RDONLY 0x00501 len 0x0005, a6xx_catalog.c:510 */
+	0x0bd0050b, /* RDONLY 0x0050b len 0x02f4, a6xx_catalog.c:511 */
+	0x8000050e, /* NORDWR 0x0050e len 0x0000, a6xx_catalog.c:512 */
+	0x80000510, /* NORDWR 0x00510 len 0x0000, a6xx_catalog.c:513 */
+	0x80000534, /* NORDWR 0x00534 len 0x0000, a6xx_catalog.c:514 */
+	0x82080800, /* NORDWR 0x00800 len 0x0082, a6xx_catalog.c:515 */
+	0x802008a0, /* NORDWR 0x008a0 len 0x0008, a6xx_catalog.c:516 */
+	0x809008ab, /* NORDWR 0x008ab len 0x0024, a6xx_catalog.c:517 */
+	0x02b808de, /* RDONLY 0x008de len 0x00ae, a6xx_catalog.c:518 */
+	0x81340900, /* NORDWR 0x00900 len 0x004d, a6xx_catalog.c:519 */
+	0x89c8098d, /* NORDWR 0x0098d len 0x0272, a6xx_catalog.c:520 */
+	0x80040e00, /* NORDWR 0x00e00 len 0x0001, a6xx_catalog.c:521 */
+	0x80300e03, /* NORDWR 0x00e03 len 0x000c, a6xx_catalog.c:522 */
+	0x830c3c00, /* NORDWR 0x03c00 len 0x00c3, a6xx_catalog.c:523 */
+	0x7ffc3cc4, /* RDONLY 0x03cc4 len 0x1fff, a6xx_catalog.c:524 */
+	0x873c8630, /* NORDWR 0x08630 len 0x01cf, a6xx_catalog.c:525 */
+	0x80008e00, /* NORDWR 0x08e00 len 0x0000, a6xx_catalog.c:526 */
+	0x80008e08, /* NORDWR 0x08e08 len 0x0000, a6xx_catalog.c:527 */
+	0x807c8e50, /* NORDWR 0x08e50 len 0x001f, a6xx_catalog.c:528 */
+	0x876c9624, /* NORDWR 0x09624 len 0x01db, a6xx_catalog.c:529 */
+	0x80049e70, /* NORDWR 0x09e70 len 0x0001, a6xx_catalog.c:530 */
+	0x861c9e78, /* NORDWR 0x09e78 len 0x0187, a6xx_catalog.c:531 */
+	0x873ca630, /* NORDWR 0x0a630 len 0x01cf, a6xx_catalog.c:532 */
+	0x8000ae02, /* NORDWR 0x0ae02 len 0x0000, a6xx_catalog.c:533 */
+	0x8cbcae50, /* NORDWR 0x0ae50 len 0x032f, a6xx_catalog.c:534 */
+	0x8000b604, /* NORDWR 0x0b604 len 0x0000, a6xx_catalog.c:535 */
+	0x8004be02, /* NORDWR 0x0be02 len 0x0001, a6xx_catalog.c:536 */
+	0xdf7cbe20, /* NORDWR 0x0be20 len 0x17df, a6xx_catalog.c:537 */
+	0xaffcf000, /* NORDWR 0x0f000 len 0x0bff, a6xx_catalog.c:538 */
+	0x7ffcfc00, /* RDONLY 0x0fc00 len 0x1fff, a6xx_catalog.c:539 */
+	0x80011c00, /* NORDWR 0x11c00 len 0x0000, a6xx_catalog.c:540 */
+};
+
+static const SweetGpuPwrBin *
+selectPwrBin(uint32_t speedBin)
+{
+	for (uint32_t i = 0; i < sizeof(kPwrBins) / sizeof(kPwrBins[0]); i++) {
+		if (kPwrBins[i].speedBin == speedBin) {
+			return &kPwrBins[i];
+		}
+	}
+	return NULL;
+}
+
+uint32_t MsmGpuAdreno618::readReg(uint32_t idx)
+{
+	return fRegs[idx];
+}
+
+void MsmGpuAdreno618::writeReg(uint32_t idx, uint32_t val)
+{
+	fRegs[idx] = val;
+}
+
+uint32_t MsmGpuAdreno618::readFuse(uint32_t byteOff)
+{
+	/* byteOff is the sweet.dts byte offset. It is 4-byte aligned (static_assert above), so byteOff / 4 is exact. */
+	return fQfpromRegs[byteOff / 4];
+}
+
+uint32_t MsmGpuAdreno618::readGpucc(uint32_t byteOff)
+{
+	/* byteOff is the byte offset from kGpuccPA. It is 4-byte aligned (static_assert above), so byteOff / 4 is exact. */
+	return fGpuccRegs[byteOff / 4];
+}
+
+bool MsmGpuAdreno618::mapWindow(IOService *provider, uint32_t index, uint64_t minBytes,
+    IOMemoryMap **map, const char *name)
+{
+	/* Mapping does not touch the hardware. */
+	*map = provider->mapDeviceMemoryWithIndex(index);
+	if (!*map) {
+		printf("SWEET GPU: %s (reg %u) map failed\n", name, index);
+		return false;
+	}
+	if ((*map)->getLength() < minBytes) {
+		printf("SWEET GPU: %s (reg %u) maps %llu bytes, DT says %llu\n", name, index,
+		    (unsigned long long)(*map)->getLength(), (unsigned long long)minBytes);
+		OSSafeReleaseNULL(*map);
+		return false;
+	}
+	printf("SWEET GPU: %s (reg %u) pa=%#llx va=%p len=%llu\n", name, index,
+	    (unsigned long long)(*map)->getPhysicalAddress(),
+	    (void *)(*map)->getVirtualAddress(),
+	    (unsigned long long)(*map)->getLength());
+	return true;
+}
+
+bool MsmGpuAdreno618::mapPhysical(uint64_t pa, uint64_t minBytes, IOMemoryMap **map,
+    const char *name)
+{
+	/*
+	 * Mapping does not touch the hardware. The map keeps the descriptor alive, so
+	 * the descriptor reference is dropped here.
+	 */
+	IOMemoryDescriptor *desc = IOMemoryDescriptor::withPhysicalAddress(pa, minBytes, kIODirectionInOut);
+	if (!desc) {
+		printf("SWEET GPU: %s pa=%#llx descriptor failed\n", name, (unsigned long long)pa);
+		return false;
+	}
+	*map = desc->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapInhibitCache);
+	OSSafeReleaseNULL(desc);
+	if (!*map) {
+		printf("SWEET GPU: %s pa=%#llx map failed\n", name, (unsigned long long)pa);
+		return false;
+	}
+	if ((*map)->getLength() < minBytes) {
+		printf("SWEET GPU: %s pa=%#llx maps %llu bytes, need %llu\n", name, (unsigned long long)pa,
+		    (unsigned long long)(*map)->getLength(), (unsigned long long)minBytes);
+		OSSafeReleaseNULL(*map);
+		return false;
+	}
+	printf("SWEET GPU: %s pa=%#llx va=%p len=%llu\n", name, (unsigned long long)pa,
+	    (void *)(*map)->getVirtualAddress(), (unsigned long long)(*map)->getLength());
+	return true;
+}
