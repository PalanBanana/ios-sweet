+/*
+ * SWEET: Adreno 618 (SM7150, a6xx) bring-up driver for XNU IOKit.
+ *
+ * Status: skeleton. start() maps the GPU MMIO block and reads identity
+ * registers only. Power-up, ring buffer and zap loading run only when the
+ * boot-arg sweetgpu=1 is set, because every register offset below that is
+ * marked VERIFY has not been checked against a6xx.xml.h yet, and a bad
+ * write on the phone hangs it.
+ */
+#ifndef _SWEET_GPU_ADRENO618_H_
+#define _SWEET_GPU_ADRENO618_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class MsmGpuAdreno618 : public IOService {
+	OSDeclareDefaultStructors(MsmGpuAdreno618);
+
+private:
+	IOMemoryMap                 *fMmio;        /* GPU register block */
+	volatile uint32_t           *fRegs;
+	IOBufferMemoryDescriptor    *fRingBuf;     /* 64 KiB command ring */
+	IOBufferMemoryDescriptor    *fZapBuf;      /* 64 KiB zap firmware */
+	uint32_t                    fRingWptr;
+	uint32_t                    fFence;
+	bool                        fReady;
+
+	uint32_t readReg(uint32_t off);
+	void     writeReg(uint32_t off, uint32_t val);
+
+	IOReturn powerUpSequence(void);
+	IOReturn initRingbuffer(void);
+	IOReturn loadZapFirmware(void);
+	bool     waitIdle(uint32_t timeoutUs);
+
+public:
+	virtual bool     init(OSDictionary *dict = NULL) override;
+	virtual IOService *probe(IOService *provider, SInt32 *score) override;
+	virtual bool     start(IOService *provider) override;
+	virtual void     stop(IOService *provider) override;
+	virtual void     free(void) override;
+
+	/*
+	 * Submit one frame: the surface lives at a physical address of
+	 * `bytes` length. Queues a CP_MEM_TO_MEM packet and bumps WPTR.
+	 * Called from the framebuffer path (SweetFramebuffer.cpp) once the
+	 * GPU path is enabled.
+	 */
+	IOReturn submitFrame(uint64_t surfacePA, uint32_t bytes, uint32_t *fenceOut);
+};
+
+#endif /* _SWEET_GPU_ADRENO618_H_ */
--- /dev/null
