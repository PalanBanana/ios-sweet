+/*
+ * SWEET: WCD9375 bring-up (see SweetWcd9375Audio.h).
+ *
+ * VERIFY result: the bus model is WRONG. wcd937x is a SoundWire codec
+ * (sound/soc/codecs/wcd937x-sdw.c, wcd937x.c has zero SLIMBUS references),
+ * not SLIMBUS. Register names come from wcd937x.h (WCD937X_*), and none of
+ * the offsets below are confirmed against it. sweetaudio=1 is refused.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include "SweetWcd9375Audio.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(SweetWcd9375Audio, IOService)
+
+/*
+ * Boot-arg gate: only the exact value 1 opens it. The buffer is int64_t and
+ * max_len is 8, because argnumcpy stores (int32_t)val at max_len 4, so
+ * sweetaudio=4294967297 would read back as 1 (bootargs.c:362). A bare name, or any value that is not
+ * the number 1, keeps the gate closed.
+ */
+static bool
+sweetAudioGateOpen(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetaudio", &value, (int)sizeof(value)) && value == 1;
+}
+
+/* VERIFY: all offsets against wcd937x.c / slimbus registers */
+enum {
+	kCodecChipId   = 0x0000,  /* VERIFY */
+	kCodecReset    = 0x0010,  /* VERIFY */
+	kSlimSlaveId   = 0x0100,  /* VERIFY */
+	kAdmChanCtl    = 0x0200,  /* VERIFY */
+	kCodecVolume   = 0x0300,  /* VERIFY: step register */
+};
+
+uint32_t SweetWcd9375Audio::readReg(uint32_t off)
+{
+	return fRegs[off / 4];
+}
+
+void SweetWcd9375Audio::writeReg(uint32_t off, uint32_t val)
+{
+	fRegs[off / 4] = val;
+}
+
+bool SweetWcd9375Audio::init(OSDictionary *dict)
+{
+	if (!super::init(dict)) {
+		return false;
+	}
+	fSlimbus = NULL;
+	fRegs = NULL;
+	fRoute = 0;
+	fVolume = 50;
+	fStreaming = false;
+	fReady = false;
+	return true;
+}
+
+bool SweetWcd9375Audio::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	fSlimbus = provider->mapDeviceMemoryWithIndex(0);
+	if (!fSlimbus) {
+		printf("SWEET AUDIO: SLIMBUS map failed\n");
+		return false;
+	}
+	fRegs = (volatile uint32_t *)fSlimbus->getVirtualAddress();
+	printf("SWEET AUDIO: SLIMBUS block mapped (no register read: offsets unverified)\n");
+
+	/* VALUE checked: only sweetaudio=1 enables codec access */
+	if (!sweetAudioGateOpen()) {
+		printf("SWEET AUDIO: sweetaudio=1 not set; codec untouched\n");
+		registerService();
+		return true;
+	}
+	/* Refused: SoundWire model (see header). Codec reset/attach not run. */
+	printf("SWEET AUDIO: sweetaudio=1 refused: WCD9375 is SoundWire, not SLIMBUS\n");
+	return false;
+}
+
+IOReturn SweetWcd9375Audio::codecReset(void)
+{
+	writeReg(kCodecReset, 1);  /* VERIFY: active-high reset */
+	IODelay(1000);
+	writeReg(kCodecReset, 0);
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetWcd9375Audio::slaveAttach(void)
+{
+	/* VERIFY: poll SLIMBUS slave enumeration until the codec reports in. */
+	for (int i = 0; i < 1000; i++) {
+		if (readReg(kSlimSlaveId)) {
+			return kIOReturnSuccess;
+		}
+		IODelay(100);
+	}
+	return kIOReturnTimeout;
+}
+
+IOReturn SweetWcd9375Audio::admChannelMap(uint32_t route)
+{
+	writeReg(kAdmChanCtl, route);  /* VERIFY: ADM channel encoding */
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetWcd9375Audio::configureRoute(uint32_t routeId, uint32_t sampleRate,
+    uint32_t channels)
+{
+	if (!fReady) {
+		return kIOReturnNotReady;
+	}
+	if (channels == 0 || channels > 2) {
+		return kIOReturnBadArgument;
+	}
+	fRoute = routeId;
+	printf("SWEET AUDIO: route %u rate %u ch %u\n", routeId, sampleRate, channels);
+	return admChannelMap(routeId);
+}
+
+IOReturn SweetWcd9375Audio::setVolume(uint32_t percent)
+{
+	if (percent > 100) {
+		percent = 100;
+	}
+	fVolume = percent;
+	if (fReady) {
+		writeReg(kCodecVolume, percent);  /* VERIFY: step scaling */
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetWcd9375Audio::startStream(void)
+{
+	if (!fReady) {
+		return kIOReturnNotReady;
+	}
+	fStreaming = true;
+	printf("SWEET AUDIO: stream on route %u\n", fRoute);
+	return kIOReturnSuccess;
+}
+
+IOReturn SweetWcd9375Audio::stopStream(void)
+{
+	fStreaming = false;
+	printf("SWEET AUDIO: stream off\n");
+	return kIOReturnSuccess;
+}
+
+void SweetWcd9375Audio::stop(IOService *provider)
+{
+	stopStream();
+	super::stop(provider);
+}
+
+void SweetWcd9375Audio::free(void)
+{
+	OSSafeReleaseNULL(fSlimbus);
+	super::free();
+}
