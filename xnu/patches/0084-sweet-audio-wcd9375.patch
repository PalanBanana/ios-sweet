+/*
+ * SWEET: WCD9375 codec + SLIMBUS/ADM routing (SM7150 audio).
+ *
+ * Status: skeleton. start() maps the SLIMBUS block and reads the codec
+ * slave id. Codec reset, slave attach and ADM routing run only with
+ * boot-arg sweetaudio=1. IOAudioFamily is not in the xnu tree, so the
+ * class derives from IOService. Route, volume and stream methods are the
+ * interface the audio bridge will call later.
+ */
+#ifndef _SWEET_WCD9375_AUDIO_H_
+#define _SWEET_WCD9375_AUDIO_H_
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+class SweetWcd9375Audio : public IOService {
+	OSDeclareDefaultStructors(SweetWcd9375Audio);
+
+private:
+	IOMemoryMap     *fSlimbus;   /* SLIMBUS / codec control block */
+	volatile uint32_t *fRegs;
+	uint32_t        fRoute;
+	uint32_t        fVolume;
+	bool            fStreaming;
+	bool            fReady;
+
+	uint32_t readReg(uint32_t off);
+	void     writeReg(uint32_t off, uint32_t val);
+
+	IOReturn codecReset(void);
+	IOReturn slaveAttach(void);
+	IOReturn admChannelMap(uint32_t route);
+
+public:
+	virtual bool init(OSDictionary *dict = NULL) override;
+	virtual bool start(IOService *provider) override;
+	virtual void stop(IOService *provider) override;
+	virtual void free(void) override;
+
+	IOReturn configureRoute(uint32_t routeId, uint32_t sampleRate, uint32_t channels);
+	IOReturn setVolume(uint32_t percent);
+	IOReturn startStream(void);
+	IOReturn stopStream(void);
+};
+
+#endif /* _SWEET_WCD9375_AUDIO_H_ */
