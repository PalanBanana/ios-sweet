+/*
+ * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ * sweetrpmhq=1 (boot-arg, exact value 1) prints a read-only ARC report from arm_init.c, stage 20.
+ * sweetrpmh=1 (boot-arg, exact value 1) lets sweet_rpmh_arc_vote send ARC votes. Without it
+ * the call only looks the resource up. A vote is still refused until its level is verified.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+int sweet_rpmh_arc_vote(const char *res, uint32_t level);
+void sweet_rpmh_arc_report(void);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_ARC          3u       /* CMD_DB_HW_ARC (cmd-db.h): ARC level resources, e.g. gfx.lvl */
+#define RH_ARC_QUERY_MAX 32u     /* aux values printed per resource by the sweetrpmhq=1 report */
+#define RH_ARC_LIST_MAX  24u     /* ARC names listed once when a lookup misses (sweetrpmhq=1 report) */
+#define RH_CMD_MAX      3u       /* commands per ACTIVE TCS payload: 3 for VRM, 1 for ARC */
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("SWEET RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("SWEET RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("SWEET RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+/* want: the slave whose entries are accepted (RH_VRM for ldoc11, RH_ARC for gfx.lvl). */
+static int
+rh_lookup_slave(const char *res, unsigned want, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != want || (addr >> 16) != want || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("SWEET RPMH: invalid slave %u entry for %s\n", want, res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	return rh_lookup_slave(res, RH_VRM, address);
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+/*
+ * One ACTIVE TCS payload of n commands: n = 3 for the VRM vote (voltage, mode, enable) and
+ * n = 1 for an ARC level vote. The checks and the sequence are the ones the VRM vote always used.
+ */
+static int
+rh_send_cmds(const uint32_t *addr, const uint32_t *data, unsigned n)
+{
+	if (n == 0 || n > RH_CMD_MAX) {
+		return EINVAL;
+	}
+	const uint32_t address = addr[0];   /* conflict check: the first command's address */
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* One WAIT/ENABLE bit per command: 7 for the VRM triple, 1 for one ARC command. */
+	const uint32_t mask = (1u << n) - 1u;
+	printf("SWEET RPMH: TCS%u ACTIVE n=%u irq-enable=%#x\n", t, n, irq_en);
+	for (unsigned c = 0; c < n; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, addr[c]) ||
+		    !rh_sync(cmd + RH_DATA, data[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, mask) || !rh_sync(b + RH_ENABLE, mask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[RH_CMD_MAX] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < n; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: ACTIVE payload complete (n=%u; rail or level requires hardware verification)\n", n);
+	return 0;
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* Voltage at +0, mode at +8, enable at +4. HPM (raw 7) is supported by this PMIC5 LDO;
+	 * enable comes last. */
+	const uint32_t addr[3] = {address, address + 8, address + 4};
+	const uint32_t data[3] = {mv, 7, 1};
+	printf("SWEET RPMH: VRM %u mV mode=7 enable=1\n", mv);
+	return rh_send_cmds(addr, data, 3);
+}
+
+static int
+rh_send_arc(uint32_t address, uint32_t level)
+{
+	const uint32_t addr[1] = {address};
+	const uint32_t data[1] = {level};
+	printf("SWEET RPMH ARC: level %u\n", level);
+	return rh_send_cmds(addr, data, 1);
+}
+
+/*
+ * sweetrpmhq=1: read-only query of the ARC level resources. It walks the same cmd-db
+ * headers as rh_lookup, but accepts the ARC slave (3) and prints the aux level table.
+ * It writes nothing: no RSC, TCS or cmd-db store is touched.
+ */
+static int
+rh_arc_query_one(const char *res, uint32_t *addr_out)
+{
+	*addr_out = 0;
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH ARC: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			++matches;
+			uint32_t addr = rh_read(rh_db, e + 16);
+			*addr_out = addr;
+			unsigned auxlen = rh_db16(e + 20);
+			uint32_t auxoff = aux + rh_db16(e + 22);
+			printf("SWEET ARC: %s addr=%#x slave=%u aux-len=%u prio=%#x:%#x%s\n",
+			    res, addr, slave, auxlen, rh_read(rh_db, e + 8), rh_read(rh_db, e + 12),
+			    (slave == RH_ARC && (addr >> 16) == RH_ARC) ? "" : " (not the ARC format)");
+			if (!rh_range(auxoff, auxlen)) {
+				printf("SWEET ARC: %s aux table out of range\n", res);
+				continue;
+			}
+			/* Sixteen values to a line, so the framebuffer shows the whole table. */
+			printf("SWEET ARC: %s aux:", res);
+			for (unsigned k = 0; k < auxlen / 2 && k < RH_ARC_QUERY_MAX; ++k) {
+				if (k && (k % 16u) == 0) {
+					printf("\nSWEET ARC:   ");
+				}
+				printf(" %x", (uint32_t)rh_db16(auxoff + 2 * k));
+			}
+			printf("\n");
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET ARC: %s lookup matches=%u\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+/* Names in the ARC slave (3), listed once when a lookup misses, so the real cmd-db names show. Read only. */
+static void
+rh_arc_list(void)
+{
+	unsigned shown = 0;
+	for (unsigned i = 0; i < 8 && shown < RH_ARC_LIST_MAX; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != RH_ARC) {
+			continue;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count && shown < RH_ARC_LIST_MAX; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			char name[9];
+			unsigned len = 0;
+			for (unsigned c = 0; c < 8; ++c) {
+				uint8_t ch = (uint8_t)(rh_read(rh_db, e + (c / 4) * 4) >> (8u * (c % 4)));
+				if (!ch) {
+					break;
+				}
+				name[len++] = (ch >= 0x20 && ch < 0x7f) ? (char)ch : '?';
+			}
+			name[len] = '\0';
+			printf("SWEET ARC: slave 3 name \"%s\" addr=%#x\n", name, rh_read(rh_db, e + 16));
+			++shown;
+		}
+	}
+}
+
+/*
+ * sweetrpmhq=1 (boot-arg, exact value 1): read-only ARC report, called once from arm_init.c right
+ * after kprintf starts (stage 20). It needs no UFS, battery or touch hardware. The RPMh client is
+ * mapped here if needed, and nothing is written. The summary at the end is the last output.
+ */
+void
+sweet_rpmh_arc_report(void)
+{
+	int64_t value = 0;
+	if (!PE_parse_boot_argn("sweetrpmhq", &value, (int)sizeof(value)) || value != 1) {
+		return;
+	}
+	static const char *const names[] = { "gfx.lvl", "cx.lvl", "mx.lvl" };
+	uint32_t addr[3] = { 0, 0, 0 };
+	bool found[3] = { false, false, false };
+	printf("\n\n=== SWEET FB STARTED: ARC QUERY BEGIN ===\n\n");
+	printf("SWEET ARC: report start (sweetrpmhq=1)\n");
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		printf("SWEET ARC: report skipped (RPMh client busy)\n");
+	} else {
+		if (rh_poisoned) {
+			printf("SWEET ARC: report skipped (previous uncertain RPMh transaction)\n");
+		} else if (rh_map() != 0) {
+			printf("SWEET ARC: report skipped (RPMh or cmd-db not mapped)\n");
+		} else if (!rh_rsc || !rh_tcs || !rh_dict || !rh_db) {
+			/* Guard: never read registers through an unmapped client. */
+			printf("SWEET ARC: RPMh client not mapped; queries skipped\n");
+		} else {
+			bool missing = false;
+			for (unsigned n = 0; n < sizeof(names) / sizeof(names[0]); ++n) {
+				found[n] = rh_arc_query_one(names[n], &addr[n]) == 0;
+				missing |= !found[n];
+			}
+			if (missing) {
+				rh_arc_list();
+			}
+		}
+		__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	}
+	/* Summary last: the newest kprintf lines stay on the framebuffer longest. */
+	printf("\n\n==================================\n");
+	for (unsigned n = 0; n < sizeof(names) / sizeof(names[0]); ++n) {
+		if (found[n]) {
+			printf("SWEET ARC: %s addr=%#x\n", names[n], addr[n]);
+		} else {
+			printf("SWEET ARC: %s addr=none\n", names[n]);
+		}
+	}
+	printf("==================================\n\n");
+}
+
+/* sweetrpmh=1 (boot-arg, exact value 1): the only way an ARC vote reaches a TCS. */
+static bool
+rh_arc_gate_open(void)
+{
+	int64_t value = 0;
+	return PE_parse_boot_argn("sweetrpmh", &value, (int)sizeof(value)) && value == 1;
+}
+
+/*
+ * Verified (resource, level) pairs. Empty on purpose: the ARC level table has not been read on
+ * hardware yet (NOTES.md session 22, Task A). Add an entry only from sweetrpmhq=1 output.
+ */
+static bool
+rh_arc_level_verified(const char *res, uint32_t level)
+{
+	(void)res;
+	(void)level;
+	return false;
+}
+
+/*
+ * ARC level vote for gfx.lvl, cx.lvl or mx.lvl. Without sweetrpmh=1 it only looks the resource
+ * up and writes nothing to the TCS. With the gate open, a vote is still refused for any level that
+ * rh_arc_level_verified() does not allow.
+ */
+int
+sweet_rpmh_arc_vote(const char *res, uint32_t level)
+{
+	static const char *const names[] = { "gfx.lvl", "cx.lvl", "mx.lvl" };
+	bool known = false;
+	for (unsigned n = 0; res && n < sizeof(names) / sizeof(names[0]); ++n) {
+		if (!strcmp(res, names[n])) {
+			known = true;
+		}
+	}
+	if (!known) {
+		printf("SWEET RPMH ARC: resource is not one of gfx.lvl, cx.lvl, mx.lvl\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH ARC: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave(res, RH_ARC, &address);
+	}
+	if (error) {
+		goto out;
+	}
+	if (!rh_arc_gate_open()) {
+		printf("SWEET RPMH ARC: %s at %#x; sweetrpmh=1 not set, no TCS write\n", res, address);
+		error = EPERM;
+		goto out;
+	}
+	if (!rh_arc_level_verified(res, level)) {
+		printf("SWEET RPMH ARC: %s level %u is not verified; refusing\n", res, level);
+		error = EPERM;
+		goto out;
+	}
+	error = rh_send_arc(address, level);
+out:
+	if (error) {
+		printf("SWEET RPMH ARC: vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+sweet_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
